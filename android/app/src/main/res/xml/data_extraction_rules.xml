<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing about a visitor belongs in a cloud backup or in a device-to-device transfer.
     The app holds no state worth keeping anyway: visits go to the server, and the toolkit
     config is extracted from the APK on first run. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /></cloud-backup>
    <device-transfer><exclude domain="root" /></device-transfer>
</data-extraction-rules>
