<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Sign-in and the API. The reader is local; nothing else here is. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The ACR39U is a USB device. Declared as not required so the app still installs
         on a tablet without OTG - it can then take manual entries, which is better than
         being uninstallable at a desk whose reader has been unplugged. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- tools:replace, because ICP's EIDAToolkit.aar and xmlsec2.aar each ship an
         <application> block declaring android:allowBackup="true" - libraries built when
         that was the platform default. Without this the manifest merger refuses to choose
         and the build fails at :app:processDebugMainManifest.

         The app's value wins, and false is the value that matters: a visitor's Emirates ID
         number and photograph must not be copied into a cloud backup or handed to a
         device-to-device transfer. Only this one attribute is replaced - their supportsRtl
         and label already agree with ours, and a broader tools:replace would hide the next
         genuine conflict instead of reporting it. -->
    <application
        android:name=".VmsApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vms"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Vms"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Brings the app forward when the reader is plugged in, and grants USB
                 permission without a dialog for the devices in device_filter.xml.
                 Reception should not have to answer a permission prompt while somebody
                 is standing at the desk. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- MSAL's return leg. The scheme and host must match the redirect URI on the
             Entra app registration exactly, which is why both come from one place in
             build.gradle.kts. -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${msalRedirectScheme}"
                    android:host="${msalRedirectHost}"
                    android:path="/${msalSignatureHash}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
