<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the main manifest for debug builds only. The release manifest never sees
     networkSecurityConfig, so release builds keep Android's defaults: no cleartext, and
     no trust in user-installed certificate authorities. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
