<UserControl x:Class="EIDAToolkitModernApp.Views.PinOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EIDAToolkitModernApp.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

        <!-- Load Finger Data Button -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Finger Data" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Finger data must be loaded before PIN operations that require biometric verification."
                           Style="{StaticResource FieldValue}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>
                <Button Content="Load Finger Data from Card"
                        Command="{Binding LoadFingerDataCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Reset PIN -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Reset PIN" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="New PIN" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ResetPinBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     MaxLength="16"
                                     PasswordChanged="ResetPinBox_PasswordChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Confirm PIN" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ResetConfirmPinBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     MaxLength="16"
                                     PasswordChanged="ResetConfirmPinBox_PasswordChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Finger Index" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ResetFingerIndexList}"
                                  SelectedIndex="{Binding ResetSelectedFingerIndex}"
                                  Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Sensor Timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ResetSensorTimeout, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <Button Content="Reset PIN"
                        Command="{Binding ResetPinCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"/>

                <TextBlock Text="Result" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ResetPinResult, Mode=OneWay}"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         Margin="0,0,0,12"/>

                <TextBlock Text="XML Response" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ResetPinXml, Mode=OneWay}"
                         Style="{StaticResource XmlResponseBox}"/>
            </StackPanel>
        </Border>

        <!-- Unblock PIN -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Unblock PIN" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="New PIN" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="UnblockPinBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     MaxLength="16"
                                     PasswordChanged="UnblockPinBox_PasswordChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Confirm PIN" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="UnblockConfirmPinBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     MaxLength="16"
                                     PasswordChanged="UnblockConfirmPinBox_PasswordChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Finger Index" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding UnblockFingerIndexList}"
                                  SelectedIndex="{Binding UnblockSelectedFingerIndex}"
                                  Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Sensor Timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding UnblockSensorTimeout, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>

                <Button Content="Unblock PIN"
                        Command="{Binding UnblockPinCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"/>

                <TextBlock Text="Result" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding UnblockPinResult, Mode=OneWay}"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         Margin="0,0,0,12"/>

                <TextBlock Text="XML Response" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding UnblockPinXml, Mode=OneWay}"
                         Style="{StaticResource XmlResponseBox}"/>
            </StackPanel>
        </Border>

    </StackPanel></ScrollViewer>
</UserControl>
