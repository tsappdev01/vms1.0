<UserControl x:Class="EIDAToolkitModernApp.Views.CardOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

        <!-- Get CSN -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Card Serial Number (CSN)" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Csn, Mode=OneWay}"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Margin="0,0,12,0"/>

                    <Button Grid.Column="1"
                            Content="Read CSN"
                            Command="{Binding GetCsnCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Check Card Status -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Card Status" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding CardStatus, Mode=OneWay}"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Margin="0,0,12,0"/>

                    <Button Grid.Column="1"
                            Content="Check Status"
                            Command="{Binding CheckCardStatusCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <TextBlock Text="XML Response" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CardStatusXml, Mode=OneWay}"
                         Style="{StaticResource XmlResponseBox}"/>
            </StackPanel>
        </Border>

        <!-- Get Interface Type -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Card Interface Type" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding InterfaceType, Mode=OneWay}"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Margin="0,0,12,0"/>

                    <Button Grid.Column="1"
                            Content="Get Interface Type"
                            Command="{Binding GetInterfaceTypeCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Operation Status -->
        <Border Style="{StaticResource CardPanel}">
            <TextBlock Text="{Binding OperationStatus}"
                       Foreground="{Binding OperationStatusColor}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
        </Border>

    </StackPanel></ScrollViewer>
</UserControl>
