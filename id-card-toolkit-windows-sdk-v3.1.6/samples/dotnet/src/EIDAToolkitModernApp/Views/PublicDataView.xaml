<UserControl x:Class="EIDAToolkitModernApp.Views.PublicDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

        <!-- Read Options -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Read Options" Style="{StaticResource SectionHeader}"/>

                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Content="Non-Modifiable Data"
                              IsChecked="{Binding ReadNonModifiable}"
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,24,0"/>
                    <CheckBox Content="Modifiable Data"
                              IsChecked="{Binding ReadModifiable}"
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,24,0"/>
                    <CheckBox Content="Photography"
                              IsChecked="{Binding ReadPhoto}"
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,24,0"/>
                    <CheckBox Content="Signature Image"
                              IsChecked="{Binding ReadSignature}"
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,24,0"/>
                    <CheckBox Content="Address"
                              IsChecked="{Binding ReadAddress}"
                              Style="{StaticResource ModernCheckBox}"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Read Public Data"
                            Command="{Binding ReadPublicDataCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Clear"
                            Command="{Binding ClearDataCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Identity -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Identity" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ID Number" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding IdNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Card Number" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CardNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>

                <!-- Photo and Signature -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Card Holder Photo" Style="{StaticResource FieldLabel}"/>
                        <Border Width="120" Height="150" Background="#F5F5F5"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <Image Source="{Binding CardHolderPhoto}" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Signature" Style="{StaticResource FieldLabel}"/>
                        <Border Width="200" Height="80" Background="#F5F5F5"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <Image Source="{Binding SignatureImage}" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Non-Modifiable Data -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Non-Modifiable Data" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="ID Type" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding IdType}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Issue Date" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding IssueDate}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Expiry Date" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ExpiryDate}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="Full Name (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FullNameEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="3">
                        <TextBlock Text="Full Name (Arabic)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FullNameArabic}" Style="{StaticResource FieldValue}"
                                   FlowDirection="RightToLeft"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Gender}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding DateOfBirth}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="2">
                        <TextBlock Text="Nationality (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NationalityEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="3">
                        <TextBlock Text="Title (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding TitleEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="3">
                        <TextBlock Text="Place of Birth (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding PlaceOfBirthEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="3">
                        <TextBlock Text="Nationality Code" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NationalityCode}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Modifiable Data -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Modifiable Data" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Occupation (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding OccupationEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Company Name (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CompanyNameEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Family ID" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FamilyId}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="Marital Status Code" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding MaritalStatusCode}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1">
                        <TextBlock Text="Sponsor Name" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding SponsorName}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="1">
                        <TextBlock Text="Residency Number" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ResidencyNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Residency Expiry" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ResidencyExpiryDate}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="Passport Number" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding PassportNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="2">
                        <TextBlock Text="Passport Country" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding PassportCountryEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="3">
                        <TextBlock Text="Passport Expiry" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding PassportExpiryDate}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="3">
                        <TextBlock Text="Mother Name (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding MotherFullNameEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="3">
                        <TextBlock Text="Mother Name (Arabic)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding MotherFullNameArabic}" Style="{StaticResource FieldValue}"
                                   FlowDirection="RightToLeft"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Home Address -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Home Address" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Emirate" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeEmirateEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeCityEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Area" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeAreaEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="Street" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeStreetEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1">
                        <TextBlock Text="Building" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeBuildingNameEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="1">
                        <TextBlock Text="PO Box" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomePoBox}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomePhoneNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="Mobile" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeMobileNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="2">
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding HomeEmail}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Work Address -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Work Address" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Emirate" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding WorkEmirateEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding WorkCityEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Street" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding WorkStreetEnglish}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="PO Box" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding WorkPoBox}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- XML Response -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="XML Response" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding XmlResponse, Mode=OneWay}"
                         Style="{StaticResource XmlResponseBox}"
                         MaxHeight="400"/>
            </StackPanel>
        </Border>
    </StackPanel></ScrollViewer>
</UserControl>
