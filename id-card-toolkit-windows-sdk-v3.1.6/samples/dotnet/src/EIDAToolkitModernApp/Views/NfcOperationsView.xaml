<UserControl x:Class="EIDAToolkitModernApp.Views.NfcOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

        <!-- Set NFC Authentication Parameters -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="NFC Authentication Parameters" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Set the NFC authentication parameters (card number, date of birth, expiry date) required before reading public data via NFC."
                           Style="{StaticResource FieldValue}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Card Number" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date of Birth -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date of Birth (yyMMdd)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding DobYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="2"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding DobMonth, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="2"/>

                            <TextBox Grid.Column="4"
                                     Text="{Binding DobDay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="2"/>
                        </Grid>
                    </StackPanel>

                    <!-- Expiry Date -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Expiry Date (yyMMdd)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding ExpiryYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="2"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding ExpiryMonth, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="2"/>

                            <TextBox Grid.Column="4"
                                     Text="{Binding ExpiryDay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="2"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="Set NFC Auth Parameters"
                            Command="{Binding SetNfcAuthCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"/>

                    <Button Content="Clear"
                            Command="{Binding ClearNfcAuthCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Read Public Data Using NFC -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Read Public Data Using NFC" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Read public data from the card via NFC device. NFC authentication parameters must be set first."
                           Style="{StaticResource FieldValue}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <!-- Data Selection Checkboxes -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox Content="Non-Modifiable"
                              IsChecked="{Binding ReadNonModifiable}"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,16,0"/>

                    <CheckBox Content="Modifiable"
                              IsChecked="{Binding ReadModifiable}"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,16,0"/>

                    <CheckBox Content="Photo"
                              IsChecked="{Binding ReadPhoto}"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,16,0"/>

                    <CheckBox Content="Signature"
                              IsChecked="{Binding ReadSignatureImage}"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,16,0"/>

                    <CheckBox Content="Address"
                              IsChecked="{Binding ReadAddress}"
                              Style="{StaticResource ModernCheckBox}"/>
                </StackPanel>

                <Button Content="Read Public Data (NFC)"
                        Command="{Binding ReadPublicDataNfcCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"/>

                <TextBlock Text="Response Status" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NfcResponseStatus, Mode=OneWay}"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         Margin="0,0,0,12"/>

                <!-- Result Fields -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="ID Number" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcIdNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Card Number" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcCardNumber}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Nationality" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcNationality}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="Full Name (English)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcFullNameEn}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1">
                        <TextBlock Text="Full Name (Arabic)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcFullNameAr}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Grid.Row="1">
                        <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcGender}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcDateOfBirth}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="Expiry Date" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding NfcExpiryDate}" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel></ScrollViewer>
</UserControl>
