<Window x:Class="EIDAToolkitModernApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EIDAToolkitModernApp.Views"
        xmlns:vm="clr-namespace:EIDAToolkitModernApp.ViewModels"
        Title="Emirates ID Card Toolkit"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="{StaticResource ContentBgBrush}">

    <Window.Resources>
        <!-- DataTemplate for each ViewModel -->
        <DataTemplate DataType="{x:Type vm:CardOperationsViewModel}">
            <local:CardOperationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PublicDataViewModel}">
            <local:PublicDataView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PinOperationsViewModel}">
            <local:PinOperationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BiometricViewModel}">
            <local:BiometricView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NfcOperationsViewModel}">
            <local:NfcOperationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PkiSigningViewModel}">
            <local:PkiSigningView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AdESSigningViewModel}">
            <local:AdESSigningView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeviceManagementViewModel}">
            <local:DeviceManagementView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolkitUtilitiesViewModel}">
            <local:ToolkitUtilitiesView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- App Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <!-- Logo area -->
                    <Border Padding="20,24,20,8">
                        <StackPanel>
                            <TextBlock Text="Emirates ID"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Card Toolkit"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14" FontWeight="Light"
                                       Foreground="#B0BEC5"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Connection Controls -->
                    <Border Padding="16,8" Background="#15202D" Margin="0,4,0,0">
                        <StackPanel>
                            <CheckBox Content="Process Mode"
                                      IsChecked="{Binding ProcessMode}"
                                      Foreground="#B0BEC5"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="11"
                                      Margin="0,0,0,8"
                                      VerticalContentAlignment="Center"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding InitializeCommand}"
                                        IsEnabled="{Binding IsInitialized, Converter={StaticResource InvertBoolConverter}}"
                                        FontSize="11" Padding="8,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Initialize"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                    <Setter Property="Content" Value="Initialized ✓"/>
                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2"
                                        Content="Cleanup"
                                        Command="{Binding CleanupCommand}"
                                        IsEnabled="{Binding IsInitialized}"
                                        Style="{StaticResource DangerButton}"
                                        FontSize="11" Padding="8,6"/>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding ConnectCommand}"
                                        FontSize="11" Padding="8,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Connect"/>
                                            <Setter Property="IsEnabled" Value="{Binding IsInitialized}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Content" Value="Connected ✓"/>
                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInitialized}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2"
                                        Content="Disconnect"
                                        Command="{Binding DisconnectCommand}"
                                        IsEnabled="{Binding IsConnected}"
                                        FontSize="11" Padding="8,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Foreground" Value="#607D8B"/>
                                            <Setter Property="BorderBrush" Value="#607D8B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="#D13438"/>
                                                    <Setter Property="BorderBrush" Value="#D13438"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Button Content="Find Readers"
                                    Command="{Binding FindReaderCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="11" Padding="8,6"
                                    Background="#37474F"
                                    Margin="0,4,0,0"/>

                            <ComboBox ItemsSource="{Binding ReaderList}"
                                      SelectedIndex="{Binding SelectedReaderIndex}"
                                      FontFamily="{StaticResource AppFont}"
                                      FontSize="11"
                                      Foreground="Black"
                                      Background="White"
                                      BorderBrush="#555555"
                                      Margin="0,4,0,0"
                                      Visibility="{Binding ReaderList.Count, Converter={StaticResource CountToVisConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Height="1" Background="#2A3F54" Margin="16,12,16,4"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="Card Operations"
                                AutomationProperties.AutomationId="NavCardOperations"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="CardOperations">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="CardOperations">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Public Data"
                                AutomationProperties.AutomationId="NavPublicData"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="PublicData">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="PublicData">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="PIN Operations"
                                AutomationProperties.AutomationId="NavPinOperations"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="PinOperations">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="PinOperations">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Biometric Auth"
                                AutomationProperties.AutomationId="NavBiometric"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Biometric">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="Biometric">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="NFC Operations"
                                AutomationProperties.AutomationId="NavNfcOperations"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="NfcOperations">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="NfcOperations">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="PKI &amp; Signing"
                                AutomationProperties.AutomationId="NavPkiSigning"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="PkiSigning">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="PkiSigning">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="AdES Signing"
                                AutomationProperties.AutomationId="NavAdESSigning"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="AdESSigning">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="AdESSigning">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Device Management"
                                AutomationProperties.AutomationId="NavDeviceManagement"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="DeviceManagement">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="DeviceManagement">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Toolkit Utilities"
                                AutomationProperties.AutomationId="NavToolkitUtilities"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="ToolkitUtilities">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="ToolkitUtilities">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Grid.Row="0">
            <!-- Page Header -->
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="White" Padding="32,16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="{Binding CurrentPageName}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="22" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ToolkitVersion}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content View  -  each view has its own ScrollViewer -->
                <ContentControl Content="{Binding CurrentView}" Margin="32,24"/>
            </DockPanel>

            <!-- Busy Overlay -->
            <Grid Background="#80000000"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="240" Height="4"
                                 Foreground="{StaticResource AccentBrush}"
                                 Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding BusyMessage}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="{StaticResource StatusBarBrush}"
                Padding="16,0">
            <DockPanel>
                <!-- Connection Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D13438"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#107C10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontFamily="{StaticResource AppFont}"
                               FontSize="11" Foreground="#B0BEC5"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text=" | " Foreground="#607D8B" FontSize="11"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding ReaderName, TargetNullValue='No reader selected'}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11" Foreground="#B0BEC5"
                               VerticalAlignment="Center"
                               MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           MaxWidth="500"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
