<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- IDCardToolkit.dll is .NET Framework 4.7.2 / x64 and P/Invokes the native
         EIDAToolkit.dll. Matching its target exactly is what the working vendor sample
         does; loading it from net8.0 is plausible but unproven, and this is not the
         place to find out. Consequently this project builds on Windows only and is
         deliberately NOT part of DI.Vms.sln, so CI on Linux stays green. -->
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>DI.Vms.CardBridge</RootNamespace>
    <AssemblyName>DI.Vms.CardBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="IDCardToolkit">
      <HintPath>..\..\id-card-toolkit-windows-sdk-v3.1.6\lib\dotnet\64\IDCardToolkit.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
