<nav class="sidebar">
    <div class="brand">
        Dubai Investments
        <span>Visitor Management</span>
    </div>

    @foreach (var group in Groups)
    {
        <div>
            <div class="nav-group-label">@group.Name</div>
            @foreach (var item in group.Items)
            {
                <NavLink class="@("nav-link" + (item.Emergency ? " emergency" : ""))"
                         href="@item.Href"
                         Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @item.Label
                </NavLink>
            }
        </div>
    }
</nav>

@code {
    private sealed record NavItem(string Href, string Label, bool Emergency = false);
    private sealed record NavGroup(string Name, NavItem[] Items);

    /* Trimmed to the two modules requested on 2026-09-03. The other screens still exist
       and still route - they are simply not in the navigation until they are asked for,
       which is reversible in a way that deleting them would not be. */
    private static readonly NavGroup[] Groups =
    [
        new("Visitor Management",
        [
            new("register", "New Visitor"),
            new("current", "Current Visitors"),
            new("checkout", "Check Out"),
        ]),
        new("Reports",
        [
            new("reports", "Reports"),
        ]),
    ];
}
