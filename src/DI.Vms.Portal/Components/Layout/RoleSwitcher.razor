@inject UserContext User

@* Development authentication reads the role from a header, so switching it here lets the
   BRD 18 authorisation matrix be exercised without maintaining four accounts. It
   disappears when Entra ID is wired up. *@

<div class="role-switcher">
    <span class="muted">Acting as</span>
    <select value="@User.Role" @onchange="OnChanged" aria-label="Acting as role">
        @foreach (var role in Enum.GetValues<UserRole>())
        {
            <option value="@role">@Humanise(role.ToString())</option>
        }
    </select>
</div>

@code {
    private void OnChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UserRole>(e.Value?.ToString(), out var role))
        {
            User.SetRole(role);
        }
    }

    private static string Humanise(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
}
