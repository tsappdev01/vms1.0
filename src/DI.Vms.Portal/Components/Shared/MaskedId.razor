@inject VmsApiClient Api

@* ID numbers render masked by default (BRD 22). Unmasking is a deliberate,
   permission-gated action that writes a VIEW-UNMASKED-ID audit row server-side -
   looking at an ID number is itself an auditable event. *@

<span class="masked">
    @if (revealed is not null)
    {
        <span>@revealed</span>
        <button class="small" @onclick="() => revealed = null" title="Hide the ID number again">Hide</button>
    }
    else
    {
        <span>@Masked</span>
        @if (VisitorId != Guid.Empty && (Masked?.Contains('X') ?? false))
        {
            <button class="small" @onclick="Reveal" disabled="@busy"
                    title="Reveal the full ID number. This is audited.">
                @(busy ? "…" : "Unmask")
            </button>
        }
    }
    @if (error is not null)
    {
        <span class="error-inline">@error</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public string? Masked { get; set; }
    [Parameter] public Guid VisitorId { get; set; }

    private string? revealed;
    private string? error;
    private bool busy;

    private async Task Reveal()
    {
        busy = true;
        error = null;
        try
        {
            revealed = await Api.GetUnmaskedIdAsync(VisitorId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
