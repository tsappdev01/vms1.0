@* A headline number is a stat tile, not a one-bar chart. *@

<div class="stat-tile">
    <div class="label">
        @if (Accent is not null)
        {
            <span class="dot" style="background:@Accent" aria-hidden="true"></span>
        }
        @Label
    </div>
    <div class="value">@(Value?.ToString() ?? "—")</div>
    @if (!string.IsNullOrEmpty(Note))
    {
        <div class="note">@Note</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public object? Value { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Accent { get; set; }
}
