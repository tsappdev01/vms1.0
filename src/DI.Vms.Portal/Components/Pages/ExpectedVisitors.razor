@page "/expected"
@rendermode InteractiveServer
@inject VmsApiClient Api

<PageTitle>Expected Visitors &middot; DI VMS</PageTitle>

<div class="page-header">
    <h1>Expected Visitors</h1>
    <p>Pre-registered visitors who have not yet arrived. Check-in happens at reception.</p>
</div>

@if (error is not null) { <ApiError Message="@error" OnRetry="Load" /> }

<section class="card">
    @if (visits is null)
    {
        <div class="empty">Loading…</div>
    }
    else if (visits.Count == 0)
    {
        <div class="empty"><strong>No expected visitors</strong><span>Pre-registration arrives in Phase 2.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Visitor</th><th>Company</th><th>Host</th><th>Entity</th><th>Expected</th><th>Type</th><th>Purpose</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var v in visits)
                    {
                        <tr>
                            <td class="strong">@v.VisitorName</td>
                            <td>@(v.Company ?? "—")</td>
                            <td>@v.HostName</td>
                            <td>@v.EntityName</td>
                            <td class="mono">@Gst.Date(v.ExpectedDate) @(v.ExpectedTime?.ToString("HH:mm") ?? "")</td>
                            <td>@Gst.Humanise(v.VisitType.ToString())</td>
                            <td>@(v.Purpose ?? "—")</td>
                            <td><StatusBadge Status="v.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<VisitListItemDto>? visits;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try { visits = await Api.GetExpectedAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }
}
