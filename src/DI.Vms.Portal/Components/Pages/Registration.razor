@page "/register"
@rendermode InteractiveServer
@inject VmsApiClient Api
@inject CardReaderClient Reader
@inject IJSRuntime Js

<PageTitle>New Visitor &middot; DI VMS</PageTitle>

@* The BRD 24 registration sequence:
   IDENTIFY -> SCAN -> VISITOR INFO -> VISIT DETAILS -> SIGNATURE -> CONFIRM -> CHECK-IN *@

@if (done is not null)
{
    <div class="page-header"><h1>Checked In</h1></div>
    <section class="card narrow-card">
        <div class="card-body">
            <div class="status big">
                <span class="dot" style="background:var(--status-good)"></span> Inside
            </div>
            <dl class="readout">
                <dt>Visit number</dt><dd>@done.VisitNumber</dd>
                <dt>Visitor</dt><dd>@name</dd>
                <dt>Meeting</dt><dd>@done.Host.Name</dd>
                <dt>Floor / office</dt><dd>@(host?.Floor ?? "—") / @(host?.Office ?? "—")</dd>
                <dt>In time</dt><dd>@Gst.Time(done.InTimeUtc) GST</dd>
            </dl>
            <div class="banner">
                <strong>Host not notified.</strong>
                <span>Host notification (BRD §8) is not built yet — tell the host manually.</span>
            </div>
            <div class="actions">
                <button class="primary" @onclick="Reset">Register another visitor</button>
            </div>
        </div>
    </section>
}
else
{
<div class="page-header">
    <h1>Visitor Registration</h1>
    <p>Identify the visitor, record the visit, capture the acknowledgement, check in.</p>
</div>

<div class="steps">
    @for (var i = 0; i < StepNames.Length; i++)
    {
        var index = i;
        <div class="step @(index == step ? "active" : "") @(index < step ? "done" : "")">
            <span class="num">@(index < step ? "✓" : (index + 1).ToString())</span>@StepNames[index]
        </div>
    }
</div>

@if (error is not null)
{
    <div class="banner critical"><strong>Problem.</strong><span>@error</span></div>
}

<section class="card narrow-card">
    <div class="card-body">

        @if (step == 0)
        {
            @if (readerStatus is not null)
            {
                <div class="banner @(readerStatus.Available ? "" : "warn")">
                    <strong>@(readerStatus.Available ? "Reader ready." : "No reader.")</strong>
                    <span>@(readerStatus.Available ? (readerStatus.ReaderName ?? "Reader connected.") : readerStatus.Detail)</span>
                </div>
            }
            <p class="muted">Ask the visitor for their Emirates ID and place it in the reader.</p>
            <div class="actions left">
                <button class="primary" @onclick="Scan" disabled="@(scanning || readerStatus?.Available != true)">
                    @(scanning ? "Reading card…" : "Read Emirates ID")
                </button>
                <button @onclick="StartManual">Enter details manually</button>
            </div>
            <p class="hint">
                Manual entry covers passports, GCC IDs and driving licences, which the toolkit
                does not read, and keeps reception working when a reader fails.
            </p>
        }

        else if (step == 1)
        {
            @if (card is not null)
            {
                <div class="banner">
                    <strong>@VerificationLabel</strong>
                    <span>
                        @(card.Verification?.VgAvailable == true
                            ? $"Card checked against the Validation Gateway. Status: {card.Verification.CardStatus}."
                            : "Validation Gateway unreachable — the visit will be flagged for later verification.")
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(card.SignatureWarning))
                {
                    <div class="banner warn"><strong>Signature warning.</strong><span>@card.SignatureWarning</span></div>
                }
            }
            <div class="field-row">
                <div class="field">
                    <label for="vname">Visitor name</label>
                    <input id="vname" @bind="name" readonly="@(card is not null)" />
                    @if (card is not null) { <div class="hint">From the card chip — not editable.</div> }
                </div>
                <div class="field">
                    <label for="vcompany">Company</label>
                    <input id="vcompany" @bind="company" placeholder="ABC Trading LLC" />
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="vid">ID number</label>
                    <input id="vid" @bind="idNumber" readonly="@(card is not null)" placeholder="784XXXXXXXXXXXX" />
                </div>
                <div class="field">
                    <label for="vexp">ID expiry</label>
                    <input id="vexp" type="date" @bind="idExpiry" readonly="@(card is not null)" />
                </div>
            </div>
            @if (card is null)
            {
                <div class="banner warn">
                    <strong>Manual entry.</strong>
                    <span>Recorded as unverified — reports distinguish this from a chip-verified identity.</span>
                </div>
            }
            <div class="actions">
                <button @onclick="() => step = 0">Back</button>
                <button class="primary" disabled="@(string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(idNumber))"
                        @onclick="() => step = 2">Continue</button>
            </div>
        }

        else if (step == 2)
        {
            <div class="field">
                <label for="entity">DI entity</label>
                <select id="entity" @bind="entityId">
                    <option value="">Select…</option>
                    @foreach (var e in entities)
                    {
                        <option value="@e.Id">@e.EntityName</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="host">Person to visit</label>
                <select id="host" @bind="hostId">
                    <option value="">Select…</option>
                    @foreach (var h in hosts)
                    {
                        <option value="@h.Id">@h.Name — @h.Department</option>
                    }
                </select>
                @if (host is not null)
                {
                    <div class="hint">
                        @host.EntityName · @host.Department · Floor @host.Floor · Office @host.Office
                        — filled in from the host record.
                    </div>
                }
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="vtype">Visitor type</label>
                    <select id="vtype" @bind="visitType">
                        @foreach (var t in Enum.GetValues<VisitorType>())
                        {
                            <option value="@t">@Gst.Humanise(t.ToString())</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="purpose">Purpose</label>
                    <input id="purpose" @bind="purpose" placeholder="Business Meeting" />
                </div>
            </div>
            <div class="actions">
                <button @onclick="() => step = 1">Back</button>
                <button class="primary" disabled="@(entityId == Guid.Empty || hostId == Guid.Empty)"
                        @onclick="() => step = 3">Continue</button>
            </div>
        }

        else if (step == 3)
        {
            <p class="muted">
                The visitor signs to acknowledge the visit. This is required — check-in cannot
                proceed without it.
            </p>
            <canvas @ref="signatureCanvas" class="signature-pad" style="height:180px"
                    aria-label="Signature area"></canvas>
            <div class="row mt">
                <span class="hint">Ask the visitor to sign above.</span>
                <button class="small" @onclick="ClearSignature">Clear</button>
            </div>
            <div class="actions">
                <button @onclick="() => step = 2">Back</button>
                <button class="primary" @onclick="CaptureSignature">Continue</button>
            </div>
        }

        else
        {
            <dl class="readout">
                <dt>Visitor</dt><dd>@name</dd>
                <dt>Company</dt><dd>@(string.IsNullOrWhiteSpace(company) ? "—" : company)</dd>
                <dt>ID expiry</dt><dd>@(idExpiry is null ? "—" : Gst.Date(idExpiry))</dd>
                <dt>Identity</dt><dd>@(card is not null ? "Read from card chip" : "Entered manually")</dd>
                <dt>DI entity</dt><dd>@(entities.FirstOrDefault(e => e.Id == entityId)?.EntityName ?? "—")</dd>
                <dt>Person to visit</dt><dd>@(host?.Name ?? "—")</dd>
                <dt>Department</dt><dd>@(host?.Department ?? "—")</dd>
                <dt>Floor / office</dt><dd>@(host?.Floor ?? "—") / @(host?.Office ?? "—")</dd>
                <dt>Purpose</dt><dd>@(string.IsNullOrWhiteSpace(purpose) ? "—" : purpose)</dd>
                <dt>Signature</dt><dd>Captured</dd>
            </dl>
            <div class="actions">
                <button @onclick="() => step = 3">Back</button>
                <button class="primary" @onclick="Submit" disabled="@busy">
                    @(busy ? "Checking in…" : "CHECK IN")
                </button>
            </div>
        }
    </div>
</section>
}

@code {
    private static readonly string[] StepNames = ["Identify", "Visitor", "Visit", "Signature", "Confirm"];

    private int step;
    private bool scanning;
    private bool busy;
    private string? error;

    private CardReaderClient.ReaderStatus? readerStatus;
    private CardReaderClient.CardRead? card;

    private string name = string.Empty;
    private string company = string.Empty;
    private string idNumber = string.Empty;
    private DateOnly? idExpiry;
    private string? nationality;
    private DateOnly? dateOfBirth;

    private Guid entityId;
    private Guid hostId;
    private string purpose = string.Empty;
    private VisitorType visitType = VisitorType.Guest;

    private ElementReference signatureCanvas;
    private string? signature;

    private List<DiEntityDto> entities = [];
    private List<EmployeeDto> hosts = [];
    private EmployeeDto? host => hosts.FirstOrDefault(h => h.Id == hostId);

    private CheckInResponse? done;

    private string VerificationLabel => card?.Verification?.CardStatus switch
    {
        "Valid" => "🟢 Verified",
        "Expired" => "🟡 ID expired",
        null or "Unknown" => "⚪ Pending verification",
        var s => "🔴 " + s,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            entities = await Api.GetEntitiesAsync() ?? [];
            hosts = await Api.GetEmployeesAsync() ?? [];
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (step == 0 && readerStatus is null)
        {
            readerStatus = await Reader.GetStatusAsync();
            StateHasChanged();
        }

        if (step == 3)
        {
            await Js.InvokeVoidAsync("vms.signature.init", signatureCanvas);
        }
    }

    private async Task Scan()
    {
        scanning = true;
        error = null;
        try
        {
            card = await Reader.ReadAsync();
            name = card.Name ?? string.Empty;
            idNumber = card.IdNumber;
            idExpiry = card.ParseDate(card.ExpiryDate);
            dateOfBirth = card.ParseDate(card.DateOfBirth);
            nationality = card.Nationality;
            step = 1;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            scanning = false;
        }
    }

    private void StartManual()
    {
        card = null;
        step = 1;
    }

    private async Task CaptureSignature()
    {
        signature = await Js.InvokeAsync<string?>("vms.signature.get", signatureCanvas);
        if (string.IsNullOrEmpty(signature))
        {
            error = "A signature is required before check-in.";
            return;
        }
        error = null;
        step = 4;
    }

    private async Task ClearSignature()
    {
        await Js.InvokeVoidAsync("vms.signature.clear", signatureCanvas);
        signature = null;
    }

    private async Task Submit()
    {
        busy = true;
        error = null;
        try
        {
            var created = await Api.CreateVisitAsync(new CreateVisitRequest(
                Visitor: new NewVisitorDto(
                    Name: name,
                    Company: string.IsNullOrWhiteSpace(company) ? null : company,
                    IdType: IdType.EmiratesId,
                    IdNumber: idNumber,
                    IdExpiryDate: idExpiry,
                    Nationality: nationality,
                    DateOfBirth: dateOfBirth,
                    Photo: card?.PhotoBase64,
                    CaptureMethod: card is not null ? IdCaptureMethod.CardReader : IdCaptureMethod.Manual),
                VisitorId: null,
                DiEntityId: entityId,
                HostEmployeeId: hostId,
                Purpose: string.IsNullOrWhiteSpace(purpose) ? null : purpose,
                VisitType: visitType,
                ExpectedDate: null,
                ExpectedTime: null));

            if (created is null)
            {
                error = "The visit could not be created.";
                return;
            }

            done = await Api.CheckInAsync(created.Id, signature!, "PORTAL");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void Reset()
    {
        step = 0;
        card = null; done = null; error = null; signature = null;
        name = company = idNumber = purpose = string.Empty;
        idExpiry = null; dateOfBirth = null; nationality = null;
        entityId = hostId = Guid.Empty;
        visitType = VisitorType.Guest;
        readerStatus = null;
    }
}
