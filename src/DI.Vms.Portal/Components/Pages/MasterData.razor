@page "/entities"
@page "/employees"
@page "/users"
@rendermode InteractiveServer
@inject VmsApiClient Api
@inject NavigationManager Nav
@implements IDisposable

@* The three master-data screens differ only in their columns, so one component serves
   all three rather than three near-identical files. *@

<PageTitle>@Title &middot; DI VMS</PageTitle>

<div class="page-header row">
    <div>
        <h1>@Title</h1>
        <p>@Description</p>
    </div>
    <div class="no-print">
        <button class="primary" disabled title="Creating and editing master data is not built yet">Add</button>
    </div>
</div>

@if (error is not null) { <ApiError Message="@error" OnRetry="Load" /> }

@if (Which == View.Employees)
{
    <div class="toolbar">
        <input class="grow" placeholder="Search host name, code or department…"
               @bind="filter" @bind:event="oninput" aria-label="Search hosts" />
    </div>
}

<section class="card">
    @if (loading)
    {
        <div class="empty">Loading…</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                @switch (Which)
                {
                    case View.Entities:
                        <thead><tr><th>Code</th><th>Entity Name</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var e in entities)
                            {
                                <tr>
                                    <td class="mono">@e.EntityCode</td>
                                    <td>@e.EntityName</td>
                                    <td>@(e.IsActive ? "Active" : "Inactive")</td>
                                </tr>
                            }
                        </tbody>
                        break;

                    case View.Employees:
                        <thead><tr><th>Code</th><th>Name</th><th>Entity</th><th>Department</th><th>Designation</th><th>Floor</th><th>Office</th><th>Email</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var e in FilteredEmployees)
                            {
                                <tr>
                                    <td class="mono">@e.EmployeeCode</td>
                                    <td class="strong">@e.Name</td>
                                    <td>@e.EntityName</td>
                                    <td>@(e.Department ?? "—")</td>
                                    <td>@(e.Designation ?? "—")</td>
                                    <td class="mono">@(e.Floor ?? "—")</td>
                                    <td class="mono">@(e.Office ?? "—")</td>
                                    <td>@(e.Email ?? "—")</td>
                                    <td>@(e.IsActive ? "Active" : "Inactive")</td>
                                </tr>
                            }
                        </tbody>
                        break;

                    default:
                        <thead><tr><th>Username</th><th>Name</th><th>Role</th><th>Reception Point</th><th>Unmasked ID</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var u in users)
                            {
                                <tr>
                                    <td class="mono">@u.Username</td>
                                    <td>@u.Name</td>
                                    <td><span class="chip">@Gst.Humanise(u.Role.ToString())</span></td>
                                    <td>@(u.SecurityLocation ?? "—")</td>
                                    <td>
                                        @if (u.CanViewUnmaskedId)
                                        {
                                            <span class="status"><span class="dot" style="background:var(--status-serious)"></span>Granted</span>
                                        }
                                        else
                                        {
                                            <span class="muted">Not granted</span>
                                        }
                                    </td>
                                    <td>@(u.IsActive ? "Active" : "Inactive")</td>
                                </tr>
                            }
                        </tbody>
                        break;
                }
            </table>
        </div>
    }
</section>

@code {
    private enum View { Entities, Employees, Users }

    private List<DiEntityDto> entities = [];
    private List<EmployeeDto> employees = [];
    private List<UserDto> users = [];
    private string filter = string.Empty;
    private string? error;
    private bool loading = true;

    private View Which => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/') switch
    {
        "/employees" => View.Employees,
        "/users" => View.Users,
        _ => View.Entities,
    };

    private string Title => Which switch
    {
        View.Employees => "Employees / Hosts",
        View.Users => "Users & Roles",
        _ => "DI Entities",
    };

    private string Description => Which switch
    {
        View.Employees => "The host master. Reception searches this instead of typing host details, and department, floor and office auto-populate from the match.",
        View.Users => "Unmasked ID access is a separate per-user grant, not implied by any role.",
        _ => "The centralised list of companies within the DI group.",
    };

    private IEnumerable<EmployeeDto> FilteredEmployees =>
        string.IsNullOrWhiteSpace(filter)
            ? employees
            : employees.Where(e =>
                $"{e.Name} {e.EmployeeCode} {e.Department} {e.EntityName}"
                    .Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override Task OnParametersSetAsync() => Load();

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            switch (Which)
            {
                case View.Entities: entities = await Api.GetEntitiesAsync() ?? []; break;
                case View.Employees: employees = await Api.GetEmployeesAsync() ?? []; break;
                default: users = await Api.GetUsersAsync() ?? []; break;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
