// A SAMPLE. Do not edit this file - it is committed, so a password typed in here is a
// password published to everyone who can read the repository, permanently.
//
// Copy it first, then edit the copy:
//
//     copy src\DI.Vms.Blazor\appsettings.Development.Local.json.example ^
//          src\DI.Vms.Blazor\appsettings.Development.Local.json
//
// That name is gitignored (appsettings.*.Local.json), which is the whole point: it is where
// a connection string with a password in it goes on a development machine. appsettings.json
// and appsettings.Development.json are both committed, and a credential committed once is in
// the repository's history for good - rotating it in the portal is then the only fix.
//
// It is loaded only when ASPNETCORE_ENVIRONMENT is Development, so it can never override the
// Web App's configuration in Azure.
{
  "ConnectionStrings": {
    // Azure SQL:
    "Vms": "Server=tcp:ts-db.database.windows.net,1433;Initial Catalog=vms;User ID=sqladmin;Password=PUT-IT-HERE;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30"

    // SQL Server on UATWEB01, or a local instance:
    // "Vms": "Server=UATWEB01;Database=VMS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  // Optional. Without these the "Person to visit" list falls back to the vms.Person table.
  // The secret is a credential: it belongs here and nowhere else in the repository.
  "Directory": {
    "Source": "EntraId",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },

  // Optional. Without this the card image is stored in the database, as it is on UATWEB01.
  "Storage": {
    "ConnectionString": "",
    "Container": "vms"
  }
}
