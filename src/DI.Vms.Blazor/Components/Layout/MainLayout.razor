@inherits LayoutComponentBase

<div class="app">
    <nav class="sidebar">
        @* The lockup: gold monogram, then the wordmark, on the corporate navy.

           If the official artwork has been dropped into wwwroot/brand it is used as-is.
           Otherwise this composes a rendition - in markup rather than SVG, because an
           SVG wordmark's layout depends on Segoe UI being installed and the two blocks
           collide wherever it is not. Flex takes whatever width the font gives it. The
           monogram is a path either way, so it never depends on a font. *@
        <div class="brand">
            @if (BrandAssets.LogoPath is { } logo)
            {
                <img class="lockup-asset" src="@logo" alt="Dubai Investments" />
            }
            else
            {
                <div class="lockup" role="img" aria-label="Dubai Investments">
                    <svg class="lockup-mark" viewBox="0 0 100 100" aria-hidden="true">
                        @* A full bowl left of an upright stem, with an enclosed teardrop
                           counter tapering to a point at the lower left. *@
                        <path fill="currentColor" d="M92 6H72a58 44 0 0 0 0 88h20V6Z" />
                        <path fill="var(--di-navy)"
                              d="M36 70C37 54 41 41 51 34c13-9 25 0 19 14-6 14-19 20-34 22Z" />
                    </svg>
                    <span class="lockup-en">
                        <b>Dubai</b><b>Investments</b>
                    </span>
                </div>
            }
            <span class="brand-sub">Visitor Management</span>
        </div>

        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M19 8v6M22 11h-6" />
            </svg>
            New Visitor
        </NavLink>

        <NavLink class="nav-link" href="report">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3v18h18" />
                <path d="M7 15l4-5 3 3 5-7" />
            </svg>
            Visitor Report
        </NavLink>

        @* Matches the reference layout. The wording is what is actually true: the
           reference read "all visitor data is secure and encrypted", and it is not - see
           the README. A reception screen a visitor can read must not claim a control the
           system does not have. *@
        <div class="side-foot">
            <div class="badge">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3l7.5 3v6c0 4.4-3 7.6-7.5 9-4.5-1.4-7.5-4.6-7.5-9V6L12 3Z" />
                    <path d="M9 12.2l2.2 2.2 3.8-4.2" />
                </svg>
            </div>
            <strong>Your Privacy. Our Priority.</strong>
            <p>Only what is on your Emirates ID is recorded, and only for this visit.</p>
        </div>

        @* So "am I running the new code" is answerable without guessing. *@
        <p class="build-stamp">@BuildInfo.Stamp</p>
    </nav>

    <div class="main">
        <header class="topbar">
            <span class="office">DIP Office</span>
            <span class="sep"></span>
            <span class="note">Times shown in Gulf Standard Time</span>
            <span class="clock">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
                @* Ticked in the browser rather than over the circuit: a per-second
                   server render for a wall clock is traffic for nothing. *@
                <span id="gst-clock">&nbsp;</span>
            </span>
        </header>

        <main class="content">@Body</main>
    </div>
</div>
