<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DI Visitor Management</title>
    <base href="/" />
    @* Tagged with the build time so a rebuild is never masked by a cached stylesheet. *@
    <link rel="stylesheet" href="app.css?v=@BuildInfo.CacheTag" />
    <link rel="icon" href="brand/di-mark.svg" type="image/svg+xml" />
    @* Inline and synchronous, so the saved choice is on <html> before anything paints.
       Loaded from app.js instead and a desk set to dark would flash white on every
       navigation. Silent if storage is unavailable: the device preference still applies,
       which is the sensible fallback rather than an error nobody can act on. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('vms-theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (e) { }
        })();
    </script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <div id="blazor-error-ui">
        Something went wrong. <a href="" class="reload">Reload</a>
        <span class="dismiss">&times;</span>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="app.js?v=@BuildInfo.CacheTag"></script>
</body>
</html>
