@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject CardCaptureOptions Capture
@inject CardReaderService Reader
@inject AgentCardReader AgentReader
@inject IJSRuntime JS
@inject ILogger<NewVisitor> Logger
@inject IDbContextFactory<VmsDbContext> DbFactory

<PageTitle>New Visitor &middot; DI VMS</PageTitle>

<h1>New Visitor</h1>
<p class="page-sub">Quick and secure visitor registration</p>

<div class="steps">
    @for (var i = 0; i < Steps.Length; i++)
    {
        var n = i;
        <div class="step @(n == step ? "active" : "") @(n < step ? "done" : "")">
            <span class="num">@(n < step ? "✓" : (n + 1).ToString())</span>
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    @((MarkupString)Steps[n].Icon)
                </svg>
            </span>
            @StepLabel(n)
        </div>
    }
</div>

@if (message is not null)
{
    <div class="banner @messageKind"><span>@message</span></div>
}

@* ---------------------------------------------------- 1. Insert and read the card *@

@if (step == 0)
{
    <section class="card">
        <div class="hero">
            <div class="hero-art">
                @* The heading sits over the illustration, as the mockup has it: at a desk
                   the picture is what a visitor looks at, so the instruction belongs on
                   it rather than only in the panel beside it. *@
                <div class="art-head">
                    <span class="ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3l7.5 3v6c0 4.4-3 7.6-7.5 9-4.5-1.4-7.5-4.6-7.5-9V6L12 3Z" />
                            <path d="M9 12.2l2.2 2.2 3.8-4.2" />
                        </svg>
                    </span>
                    <span>
                        <strong>Insert your Emirates ID</strong>
                        <span>Place the card into the reader chip-first</span>
                    </span>
                </div>

                <div class="art-stage">
                    @* A photograph of the actual reader if one has been dropped in. It
                       shows which way round the card goes better than any drawing, and
                       the drawn version below is the fallback - the same arrangement the
                       lockup uses, after the hand-drawn logo was never quite the logo. *@
                    @if (BrandAssets.ReaderImagePath is { } reader)
                    {
                        <img class="art-photo" src="@reader"
                             alt="An Emirates ID card being inserted chip-first into the card reader" />
                    }
                    else
                    {
                        @* Deliberately no <text> elements: <text> is Razor's literal-content
                           marker, used that way further down this same file, so an SVG that
                           relied on it would be at the mercy of parser context. The card's
                           bilingual header is drawn as bars, which also reads better than
                           6px type at this size. *@
                        <svg viewBox="0 0 400 300" role="img"
                             aria-label="An Emirates ID card being inserted chip-first into a contact card reader">
                            <defs>
                                <linearGradient id="cardface" x1="0" y1="0" x2="0.5" y2="1">
                                    <stop offset="0" stop-color="var(--surface)" />
                                    <stop offset="1" stop-color="var(--accent-tint)" />
                                </linearGradient>
                                <linearGradient id="readertop" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="var(--surface)" />
                                    <stop offset="1" stop-color="var(--surface-2)" />
                                </linearGradient>
                                <linearGradient id="readerfront" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="var(--surface-2)" />
                                    <stop offset="1" stop-color="var(--surface-sunk)" />
                                </linearGradient>
                                <radialGradient id="deskglow" cx="0.5" cy="0.5" r="0.5">
                                    <stop offset="0" stop-color="var(--accent)" stop-opacity=".16" />
                                    <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                                </radialGradient>
                            </defs>

                            <!-- skyline, kept faint: identity without noise -->
                            <g stroke="var(--accent)" fill="none" opacity=".12" stroke-width="1.5" stroke-linejoin="round">
                                <path d="M26 214v-46l10-12 10 12v46" />
                                <path d="M56 214v-64l14-10 14 10v64" />
                                <path d="M94 214v-34l8-8 8 8v34" />
                                <path d="M206 214V56l6-32 6 32v158" />
                                <path d="M198 214V116l8-10 8 10" />
                                <path d="M190 214v-66l8-8 8 8" />
                                <path d="M296 214v-76l16-12 16 12v76" />
                                <path d="M338 214v-44l10-8 10 8v44" />
                                <path d="M368 214v-28l7-6 7 6v28" />
                            </g>

                            <ellipse cx="200" cy="234" rx="168" ry="46" fill="url(#deskglow)" />

                            <!-- reader, in perspective: the top face, then the card, then
                                 the slot and the front over it, so the card reads as going
                                 in rather than resting on top -->
                            <polygon points="132,196 280,196 296,222 106,222"
                                     fill="url(#readertop)" stroke="var(--text-muted)" stroke-width="1.2" />

                            <g transform="rotate(-15 204 214)">
                                <rect x="132" y="112" width="150" height="104" rx="9"
                                      fill="url(#cardface)" stroke="var(--accent)" stroke-width="1.6" />
                                <g stroke="var(--text-muted)" stroke-linecap="round" opacity=".58">
                                    <path d="M142 126h44" stroke-width="3" />
                                    <path d="M142 134h30" stroke-width="2.3" />
                                    <path d="M272 126h-40" stroke-width="3" />
                                    <path d="M272 134h-26" stroke-width="2.3" />
                                </g>
                                <path d="M202 123h9l-4.5 9z" fill="var(--di-gold)" opacity=".9" />
                                <rect x="230" y="144" width="40" height="50" rx="5"
                                      fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.1" />
                                <circle cx="250" cy="162" r="8.5" fill="var(--text-muted)" opacity=".4" />
                                <path d="M237 189a13 13 0 0 1 26 0z" fill="var(--text-muted)" opacity=".4" />
                                <g stroke="var(--border)" stroke-linecap="round" stroke-width="4">
                                    <path d="M180 156h40" />
                                    <path d="M180 167h26" />
                                </g>
                                <!-- the chip: the end that goes in, and the only part read -->
                                <rect x="142" y="158" width="30" height="24" rx="3.5"
                                      fill="var(--di-gold-tint)" stroke="var(--di-gold)" stroke-width="1.4" />
                                <path d="M149 163v14M157 163v14M165 163v14" stroke="var(--di-gold)" stroke-width="1.1" />
                                <path d="M142 193h50" stroke="var(--border)" stroke-linecap="round" stroke-width="3.4" />
                            </g>

                            <polygon points="152,204 262,204 268,212 146,212"
                                     fill="var(--text-primary)" opacity=".8" />
                            <path d="M106 222h190v22a6 6 0 0 1-6 6H112a6 6 0 0 1-6-6z"
                                  fill="url(#readerfront)" stroke="var(--text-muted)" stroke-width="1.2" />
                            <rect x="196" y="234" width="74" height="4" rx="2" fill="var(--status-good)" opacity=".85" />
                            <circle cx="182" cy="236" r="3.2" fill="var(--status-good)" />
                        </svg>
                    }
                </div>

                @* What happens, in the order it happens. Every claim here is one the
                   system actually makes good on - see the note in the README about the
                   reference mockup's "secure and encrypted", which it does not. *@
                <ol class="art-steps">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2.5" y="6" width="19" height="12" rx="2.2" /><rect x="6" y="10" width="5" height="4" rx="1" />
                        </svg>
                        Chip-first into the reader
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 8a12 12 0 0 1 0 8M8.5 6a16 16 0 0 1 0 12" /><circle cx="15" cy="12" r="2.5" />
                            <path d="M19 9.5a5 5 0 0 1 0 5" />
                        </svg>
                        Read from the chip
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                        </svg>
                        Takes a few seconds
                    </li>
                </ol>
            </div>

            <div class="hero-panel">
                @* A host with no reader says so once, plainly, and offers the only path it
                   has. The alternative - leaving the Read Card button there - costs three
                   failed attempts per visitor before the manual fallback appears, and
                   teaches the desk that the app is broken. See docs/deployment.md. *@
                @if (!Capture.ReadsCards)
                {
                    <span class="ready waiting">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2.5" y="5" width="19" height="14" rx="2.2" /><path d="M6.5 10h5M6.5 14h7" />
                        </svg>
                        <text>Manual entry</text>
                    </span>

                    <p class="lead">Enter the visitor's details.</p>
                    <p class="muted">
                        There is no card reader on this machine, so the Emirates ID cannot be
                        read from its chip here. Type the details from the card instead - the
                        entry is marked as entered manually, so it is never taken for a chip
                        read.
                    </p>
                }
                else if (readerState is null)
                {
                    <p class="lead">Checking the reader…</p>
                }
                else
                {
                    <span class="ready @(readerState.Available ? "" : "waiting")">
                        @if (readerState.Available)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 4.5-5" />
                            </svg>
                            <text>Ready to scan</text>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" />
                            </svg>
                            <text>Waiting for a card</text>
                        }
                    </span>

                    <p class="lead">Insert the Emirates ID into the reader.</p>
                    <p class="muted">Please place the card on the reader to proceed.</p>

                    <div class="reader-state @(readerState.Available ? "ok" : "waiting")">
                        <span class="icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="13" width="20" height="8" rx="2" />
                                <path d="M6 17h10" />
                                <rect x="7" y="3" width="10" height="8" rx="1.5" />
                            </svg>
                        </span>
                        <span>
                            <strong>@(TidyReaderName(readerState.ReaderName) ?? "No reader detected")</strong>
                            <span>@readerState.Detail</span>
                        </span>
                        @if (readerState.Available)
                        {
                            <svg class="state-tick" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 4.5-5" />
                            </svg>
                        }
                    </div>

                    @if (readerState.ToolkitVersion is not null || readerState.LicenceExpiry is not null)
                    {
                        <p class="hint">
                            Toolkit @(readerState.ToolkitVersion ?? "—")
                            @if (readerState.LicenceExpiry is not null)
                            {
                                <text> &middot; licence valid till @readerState.LicenceExpiry</text>
                            }
                            @* A licence that lapses stops every read, and replacing the last
                               one took ICP a fortnight - so the count is on screen, and turns
                               into a warning while there is still time to act on it. *@
                            @* The countdown appears only while it is worth acting on. A
                               licence with two years left is a fact about the toolkit; one
                               with two months left is a job for somebody, and last time
                               ICP took a fortnight over it. *@
                            @if (readerState.LicenceDaysRemaining is { } days)
                            {
                                @if (days < 0)
                                {
                                    <text> &middot; </text><span class="expiry critical">expired @(-days) days ago</span>
                                }
                                else if (days <= 60)
                                {
                                    <text> &middot; </text><span class="expiry warn">expires in @days days</span>
                                }
                            }
                        </p>
                    }
                }

                @if (!Capture.ReadsCards)
                {
                    <div class="actions">
                        <button class="primary large" @onclick="StartManualEntry">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true">
                                <path d="M4 20h16" /><path d="M14.5 4.5l4 4L9 18H5v-4l9.5-9.5Z" />
                            </svg>
                            <text>Enter details</text>
                        </button>
                    </div>
                }
                else
                {
                    <div class="actions">
                        <button class="primary large" @onclick="ReadCard" disabled="@reading">
                            @if (reading)
                            {
                                <span class="spinner" aria-hidden="true"></span>
                                <text>Reading card…</text>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="17" height="17" aria-hidden="true">
                                    <path d="M4 8a12 12 0 0 1 0 8M8.5 6a16 16 0 0 1 0 12" />
                                    <circle cx="15" cy="12" r="2.5" />
                                    <path d="M19 9.5a5 5 0 0 1 0 5" />
                                </svg>
                                <text>Read Card</text>
                            }
                        </button>
                        <button @onclick="CheckReader" disabled="@reading">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="16" height="16" aria-hidden="true">
                                <circle cx="11" cy="11" r="7" /><path d="M16 16l4.5 4.5" />
                            </svg>
                            Check reader
                        </button>
                    </div>

                    @* While a read is in flight the phase replaces the tip: the tip is advice
                       for when nothing is happening, and two panels would just compete. *@
                    @if (reading)
                    {
                        <div class="tip">
                            <span class="reading-phase">
                                <span class="spinner" aria-hidden="true"></span>
                                <span aria-live="polite">@readingPhase</span>
                            </span>
                        </div>
                    }
                    else
                    {
                        @* Offered after three failures - before that the reader is the
                           better answer and a shortcut only invites skipping it - or at
                           once when the desk has no agent, where waiting out three
                           failures teaches nothing anyone did not already know. *@
                        @if (failedReads >= 3 || agentMissing)
                        {
                            <div class="fallback">
                                @if (agentMissing)
                                {
                                    @* The reader panel above already carries the reason.
                                       This is the offer, not a second account of it. *@
                                    <strong>This PC cannot read the card.</strong>
                                }
                                else
                                {
                                    <strong>The card has not been read after @failedReads attempts.</strong>
                                }
                                <p>
                                    Enter the visitor's details by hand instead? The entry will be
                                    marked as entered manually, so it is never taken for a chip read.
                                </p>
                                <div class="actions">
                                    <button @onclick="StartManualEntry">Enter manually</button>
                                    <button class="primary" @onclick="ReadCard" disabled="@reading">Try again</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="tip">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M9 18h6M10 21h4" />
                                    <path d="M12 3a6 6 0 0 1 3.5 10.9V15h-7v-1.1A6 6 0 0 1 12 3Z" />
                                </svg>
                                <span><b>Tip:</b> Ensure the card chip is clean and try again if not detected.</span>
                            </div>
                        }
                    }

                    @* The reference mockup put "Secure - encrypted read" and "never stored
                       as an image" here. Neither is true: the photograph and the signature
                       ARE stored with the visit, the socket to the desk agent is plain
                       ws:// on loopback, and the application has no authorisation at all.
                       A visitor standing at the desk reads this panel, so it says what the
                       system actually does. *@
                    <div class="assure-strip">
                        <span class="ico">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2.5" y="5" width="19" height="14" rx="2.2" /><path d="M6 15h5" />
                                <circle cx="16.5" cy="11" r="2.4" />
                            </svg>
                        </span>
                        <p>
                            Your details are read from the chip in the card, not typed in by hand.
                            <span class="tags">Chip-read &bull; Bilingual &bull; Time-stamped</span>
                        </p>
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="assurances">
        <div class="assurance">
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M6 10h4M6 14h7" /><circle cx="17" cy="12" r="2.5" />
                </svg>
            </span>
            @* The claim has to match the host: on one with no reader nothing is read off
               a chip, and a visitor can read this panel. *@
            @if (Capture.ReadsCards)
            {
                <div>
                    <strong>Straight from the chip</strong>
                    <p>Name, nationality and photograph are read off the card itself, never transcribed.</p>
                </div>
            }
            else
            {
                <div>
                    <strong>From your Emirates ID</strong>
                    <p>Only what is printed on the card is recorded, and the entry says it was entered by hand.</p>
                </div>
            }
        </div>
        <div class="assurance">
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
                </svg>
            </span>
            <div>
                <strong>Fast &amp; Efficient</strong>
                <p>@(Capture.ReadsCards
                        ? "Two fields to fill. Everything else is already on the card, so check-in takes seconds."
                        : "Only what the visit needs: the ID number, the name, and who is being visited.")</p>
            </div>
        </div>
        <div class="assurance">
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                </svg>
            </span>
            <div>
                <strong>Stamped on save</strong>
                <p>Every entry keeps the moment it was recorded, stored in UTC and shown in Gulf Standard Time.</p>
            </div>
        </div>
    </div>
}

@* ------------------------------------------- 2. Visitor information from the chip *@

else if (step == 1 && card is not null && IsManual)
{
    @* Typed, not read. No card facsimile: drawing a picture of an Emirates ID from
       keystrokes would present typing as evidence. *@
    <section class="card narrow">
        <div class="card-head">
            <h2>Visitor Details</h2>
            <span class="badge-manual">Entered manually</span>
        </div>
        <div class="card-body">
            <p class="muted">
                Copy these from the face of the card. ID number and full name are required;
                the rest are recorded when given.
            </p>

            <div class="grid-2 mt">
                <div class="field">
                    <label for="m-id">ID Number <span class="req">required</span></label>
                    <input id="m-id" maxlength="@FieldLengths.IdNumber" @bind="manual.IdNumber" @bind:event="oninput"
                           placeholder="784-1979-4076928-0" inputmode="numeric" autocomplete="off" />
                    @if (IdDigits.Length > 0 && IdDigits.Length != FieldLengths.EmiratesIdDigits)
                    {
                        <span class="field-note warn">
                            @IdDigits.Length of @FieldLengths.EmiratesIdDigits digits. An Emirates ID number has @FieldLengths.EmiratesIdDigits.
                        </span>
                    }
                </div>

                <div class="field">
                    <label for="m-card">Card Number</label>
                    <input id="m-card" maxlength="@FieldLengths.CardNumber" @bind="manual.CardNumber" placeholder="139620213" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="m-name">Full Name (English) <span class="req">required</span></label>
                    <input id="m-name" maxlength="@FieldLengths.Name" @bind="manual.FullNameEnglish" @bind:event="oninput"
                           placeholder="As printed on the card" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="m-name-ar">Full Name (Arabic)</label>
                    <input id="m-name-ar" maxlength="@FieldLengths.Name" @bind="manual.FullNameArabic" dir="rtl" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="m-nat">Nationality</label>
                    <input id="m-nat" maxlength="@FieldLengths.CardField" @bind="manual.NationalityEnglish" placeholder="Pakistan" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="m-dob">Date of Birth</label>
                    <input id="m-dob" maxlength="@FieldLengths.CardField" @bind="manual.DateOfBirth" placeholder="08/10/1979" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="m-expiry">Card Expiry</label>
                    <input id="m-expiry" maxlength="@FieldLengths.CardField" @bind="manual.ExpiryDate" placeholder="25/08/2028" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="m-mobile">Mobile</label>
                    <input id="m-mobile" maxlength="@FieldLengths.CardField" @bind="manual.AddressMobile" inputmode="tel" autocomplete="off" />
                </div>
            </div>

            <div class="actions">
                <button @onclick="Restart">Back to the reader</button>
                <button class="primary" @onclick="ToVisitDetails" disabled="@(!ManualIsComplete)">
                    Continue
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <path d="M5 12h13M13 6l6 6-6 6" />
                    </svg>
                </button>
            </div>
        </div>
    </section>
}

else if (step == 1 && card is not null)
{
    @* The card itself, in the panel that held the illustration a moment ago, so the
       screen and the card in the attendant's hand can be compared side by side. *@
    <section class="card">
        <div class="hero hero-card">
            <div class="hero-art">
                <EmiratesIdCard Card="card" />
            </div>

            <div class="hero-panel">
                <span class="ready">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 4.5-5" />
                    </svg>
                    <text>Card read</text>
                </span>

                <p class="lead">@card.FullNameEnglish</p>
                @if (!string.IsNullOrWhiteSpace(card.FullNameArabic))
                {
                    <p class="identity-name-ar" dir="rtl">@card.FullNameArabic</p>
                }

                <div class="readout compact">
                    <dt>ID Number</dt><dd class="mono">@card.IdNumber</dd>
                    <dt>Card Number</dt><dd class="mono">@(string.IsNullOrWhiteSpace(card.CardNumber) ? "—" : card.CardNumber)</dd>
                    <dt>Nationality</dt><dd>@(string.IsNullOrWhiteSpace(card.NationalityEnglish) ? "—" : card.NationalityEnglish)</dd>
                    <dt>Card expires</dt><dd class="mono">@(string.IsNullOrWhiteSpace(card.ExpiryDate) ? "—" : card.ExpiryDate)</dd>
                </div>

                @if (card.SignatureWarning is not null)
                {
                    <div class="tip">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" />
                        </svg>
                        <span><b>Note.</b> @card.SignatureWarning</span>
                    </div>
                }

                <div class="actions">
                    <button @onclick="Restart">Read a different card</button>
                    <button class="primary" @onclick="ToVisitDetails">
                        Continue
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                            <path d="M5 12h13M13 6l6 6-6 6" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </section>

    @* Collapsed by default, as <details> rather than a scripted panel: the essentials
       are already in the strip above, so what these hold is confirmation rather than
       reading matter, and a shorter step 2 is a faster desk. Native disclosure gets the
       keyboard and the screen reader behaviour for free, and survives a circuit that has
       not finished connecting. *@
    <details class="fold">
        <summary>
            <span class="fold-title">Non-Modifiable Data</span>
            <span class="fold-sub">As read from the chip</span>
            <svg class="fold-chevron" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </summary>
        <div class="card-body grid-3">
            <Field Label="ID Type" Value="@card.IdType" />
            <Field Label="Issue Date" Value="@card.IssueDate" />
            <Field Label="Expiry Date" Value="@card.ExpiryDate" />
            <Field Label="Full Name (English)" Value="@card.FullNameEnglish" />
            <Field Label="Full Name (Arabic)" Value="@card.FullNameArabic" Rtl="true" />
            <Field Label="Nationality (English)" Value="@card.NationalityEnglish" />
            <Field Label="Gender" Value="@card.Gender" />
            <Field Label="Date of Birth" Value="@card.DateOfBirth" />
            <Field Label="Nationality Code" Value="@card.NationalityCode" />
            <Field Label="Title (English)" Value="@card.TitleEnglish" />
            <Field Label="Place of Birth (English)" Value="@card.PlaceOfBirthEnglish" />
        </div>
    </details>

    <details class="fold">
        <summary>
            <span class="fold-title">Home Address</span>
            @* The card tested carried no postal address at all - every field blank but
               mobile and email. Said on the summary so it is answered without opening. *@
            <span class="fold-sub">
                @(card.HasNoPostalAddress ? "No postal address held on this card" : "As read from the chip")
            </span>
            <svg class="fold-chevron" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </summary>
        <div class="card-body grid-3">
            <Field Label="Emirate" Value="@card.AddressEmirate" />
            <Field Label="City" Value="@card.AddressCity" />
            <Field Label="Area" Value="@card.AddressArea" />
            <Field Label="Street" Value="@card.AddressStreet" />
            <Field Label="Building" Value="@card.AddressBuilding" />
            <Field Label="PO Box" Value="@card.AddressPoBox" />
            <Field Label="Phone" Value="@card.AddressPhone" />
            <Field Label="Mobile" Value="@card.AddressMobile" Highlight="true" />
            <Field Label="Email" Value="@card.AddressEmail" Highlight="true" />
        </div>
    </details>

}

@* --------------------------------------------- 3. Entity and person, then save *@

else if (step == 2 && card is not null)
{
    <section class="card narrow">
        <div class="card-head">
            <h2>Visit Details</h2>
            @if (IsManual)
            {
                <span class="badge-manual">Entered manually</span>
            }
        </div>
        <div class="card-body">
            <div class="readout">
                <dt>Visitor</dt><dd>@card.FullNameEnglish</dd>
                <dt>ID Number</dt><dd class="mono">@card.IdNumber</dd>
            </div>

            <div class="field mt">
                <label for="entity">Entity being visited</label>
                @* The list is the Entity table, active rows only, read fresh from the
                   database each time this screen opens. *@
                @if (entities.Count == 0)
                {
                    <div class="banner warn">
                        <strong>No entities.</strong>
                        <span>
                            The <code>vms.Entity</code> table has no active rows, so there is
                            nothing to choose. The list is maintained in the database, not in
                            the application — run the entity insert script against
                            <code>VMS</code>, then retry.
                        </span>
                    </div>
                    <button @onclick="LoadEntities">Retry</button>
                }
                else
                {
                    <select id="entity" @bind="entityId" @bind:after="ClearHost">
                        <option value="0">Select an entity…</option>
                        @foreach (var e in entities)
                        {
                            <option value="@e.Id">@e.Name</option>
                        }
                    </select>
                }
            </div>

            <div class="field">
                <label for="person">Person to visit</label>
                <PersonPicker Id="person"
                              Text="@personToVisit"
                              TextChanged="@(t => personToVisit = t)"
                              PersonChanged="@(p => host = p)"
                              Search="SearchPeople"
                              MaxLength="@FieldLengths.PersonToVisit"
                              Placeholder="Start typing a name" />

                <div class="field-aside">
                    <label class="check">
                        <input type="checkbox" @bind="searchAllEntities" @bind:after="ClearHost" />
                        Search all entities
                    </label>

                    @if (host is not null)
                    {
                        <span class="picked">
                            @host.DisplayName@(string.IsNullOrWhiteSpace(host.Title) ? "" : $" · {host.Title}")
                        </span>
                    }
                    else if (!string.IsNullOrWhiteSpace(personToVisit))
                    {
                        <span class="picked typed">Not in the list — recorded as typed</span>
                    }
                </div>

                @* Offered rather than done silently: narrowing to the entity is the point
                   of the filter, and quietly widening it would hide that the host belongs
                   somewhere else. *@
                @if (noMatchInEntity && !searchAllEntities)
                {
                    <span class="field-note warn">
                        No match in @(entities.FirstOrDefault(e => e.Id == entityId)?.Name ?? "this entity").
                        <button class="link" @onclick="SearchEverywhere">Search all entities</button>
                    </span>
                }
            </div>

            <div class="field">
                <label for="purpose">Purpose of visit</label>
                <select id="purpose" @bind="purpose" @bind:after="PurposeChanged">
                    <option value="">Select purpose of visit…</option>
                    @foreach (var p in Purposes)
                    {
                        <option value="@p">@p</option>
                    }
                    <option value="@OtherPurpose">@OtherPurpose</option>
                </select>
            </div>

            @if (purpose == OtherPurpose)
            {
                <div class="field">
                    <label for="purpose-other">Please give details</label>
                    <input id="purpose-other" maxlength="@FieldLengths.PurposeOther" @bind="purposeOther" @bind:event="oninput"
                           placeholder="What is the visit for?" autocomplete="off" />
                </div>
            }

            <div class="actions">
                <button @onclick="() => step = 1">Back</button>
                <button class="primary" @onclick="AskToSave"
                        disabled="@(saving || !VisitIsComplete)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                    @(saving ? "Saving…" : "Save entry")
                </button>
            </div>
        </div>
    </section>
}

@* ------------------------------------------------------------------ 4. Saved *@

else if (step == 3 && saved is not null)
{
    <section class="card narrow">
        <div class="card-body">
            <div class="saved-mark">
                <span class="saved-ring">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                </span>
                <span>
                    <strong>Entry saved</strong>
                    <span>The visitor is recorded against the entity and the host.</span>
                </span>
            </div>
            <div class="readout">
                <dt>Reference</dt><dd class="mono">#@saved.Id</dd>
                <dt>Visitor</dt><dd>@saved.FullNameEnglish</dd>
                <dt>ID Number</dt><dd class="mono">@saved.IdNumber</dd>
                <dt>Entity</dt><dd>@entities.FirstOrDefault(e => e.Id == saved.DiEntityId)?.Name</dd>
                <dt>Person to visit</dt>
                <dd>
                    @saved.PersonToVisit@(string.IsNullOrWhiteSpace(saved.PersonToVisitTitle) ? "" : $" · {saved.PersonToVisitTitle}")
                </dd>
                <dt>Purpose</dt>
                <dd>
                    @saved.Purpose@(string.IsNullOrWhiteSpace(saved.PurposeOther) ? "" : $" — {saved.PurposeOther}")
                </dd>
                <dt>Recorded</dt><dd class="mono">@ToGst(saved.RecordedAtUtc) GST</dd>
                <dt>Source</dt>
                <dd>
                    @if (saved.CaptureMethod == "Manual")
                    {
                        <span class="badge-manual">Entered manually</span>
                    }
                    else
                    {
                        <text>Read from the chip</text>
                    }
                </dd>
            </div>
            <div class="actions">
                <button class="primary" @onclick="Restart">New Visitor</button>
                <a class="button" href="report">View report</a>
            </div>
        </div>
    </section>
}

@* --------------------------------------------------- Confirm before committing *@

@* A last look rather than a bare "are you sure": the whole point of the pause is to
   catch the wrong entity or the wrong host, so the dialog restates what will be
   written. Escape and Cancel both back out. *@
@if (confirming && card is not null)
{
    <div class="backdrop" @onclick="() => confirming = false"></div>

    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title"
         @onkeydown="OnConfirmKeyDown" tabindex="-1">
        <div class="modal-head">
            <h2 id="confirm-title">Save this entry?</h2>
            @if (IsManual)
            {
                <span class="badge-manual">Entered manually</span>
            }
        </div>

        <div class="modal-body">
            <div class="readout compact">
                <dt>Visitor</dt><dd>@card.FullNameEnglish</dd>
                <dt>ID Number</dt><dd class="mono">@(IsManual ? IdDigits : card.IdNumber)</dd>
                <dt>Entity</dt><dd>@(entities.FirstOrDefault(e => e.Id == entityId)?.Name ?? "—")</dd>
                <dt>Person to visit</dt>
                <dd>
                    @personToVisit@(host?.Title is { Length: > 0 } t ? $" · {t}" : "")
                    @if (host is null)
                    {
                        <span class="picked typed">typed, not from the list</span>
                    }
                </dd>
                <dt>Purpose</dt>
                <dd>@purpose@(purpose == OtherPurpose ? $" — {purposeOther}" : "")</dd>
            </div>

            <p class="hint mt">Recorded with the time it is saved, in Gulf Standard Time.</p>
        </div>

        <div class="modal-actions">
            <button @onclick="() => confirming = false" disabled="@saving">Cancel</button>
            <button class="primary" @onclick="Save" disabled="@saving" @ref="confirmButton">
                @if (saving)
                {
                    <span class="spinner" aria-hidden="true"></span>
                    <text>Saving…</text>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                    <text>Confirm and save</text>
                }
            </button>
        </div>
    </div>
}

@* ------------------------------------------------------------------- Toast *@

@if (toast is not null)
{
    <div class="toast" role="status" aria-live="polite">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M8.4 12.4l2.6 2.6 4.6-5.2" />
        </svg>
        <span>@toast</span>
        <button class="toast-close" @onclick="DismissToast" aria-label="Dismiss">&times;</button>
    </div>
}

@code {
    /// <summary>
    /// The four steps and their icons. Icon markup is a compile-time constant, never
    /// anything that came off a card, so rendering it as markup is safe.
    /// </summary>
    private static readonly (string Label, string Icon)[] Steps =
    [
        ("Insert Card",
         """<rect x="2.5" y="5" width="19" height="14" rx="2.2" /><path d="M6.5 10h4M6.5 14h6" /><circle cx="17" cy="11.5" r="2" />"""),
        ("Visitor Information",
         """<circle cx="12" cy="8.2" r="3.4" /><path d="M5.6 20a6.4 6.4 0 0 1 12.8 0" />"""),
        ("Visit Details",
         """<rect x="3.5" y="5.5" width="17" height="15" rx="2.2" /><path d="M8 3v4M16 3v4M3.5 10.5h17" />"""),
        ("Saved",
         """<circle cx="12" cy="12" r="8.6" /><path d="M8.4 12.4l2.6 2.6 4.6-5.2" />"""),
    ];

    /// <summary>
    /// The first step is not "Insert Card" on a host that cannot read one.
    /// </summary>
    private string StepLabel(int index) =>
        index == 0 && !Capture.ReadsCards ? "Visitor Details" : Steps[index].Label;

    private int step;
    private bool reading;
    private string? readingPhase;

    /// <summary>
    /// Consecutive failed reads. After three the attendant is offered manual entry,
    /// because a queue at the desk should not depend on a chip that will not answer.
    /// Reset by a successful read and by starting over.
    /// </summary>
    private int failedReads;

    /// <summary>
    /// True when the desk has no ICP agent answering. Distinct from a failed read: no
    /// number of retries will fix it, so manual entry is offered immediately.
    /// </summary>
    private bool agentMissing;

    private bool UsesAgent => Capture.Mode == CardCaptureMode.Agent;

    private IJSObjectReference? agentModule;

    /// <summary>
    /// How the identity in front of us was obtained. Stored on the entry, so a typed
    /// record is never mistaken for one the chip produced.
    /// </summary>
    private string captureMethod = "CardReader";

    private bool IsManual => captureMethod == "Manual";

    /// <summary>
    /// The manual form's model. Non-nullable so the field bindings need no null-forgiving
    /// operators; <c>card</c> is pointed at this same object, so everything downstream -
    /// visit details, save, the report - reads one place regardless of how the identity
    /// was obtained.
    /// </summary>
    private CardData manual = new();
    private bool saving;
    private string? message;
    private string messageKind = "";

    private ReaderState? readerState;
    private CardData? card;

    /// <summary>
    /// The purposes the desk offers, and the one that asks for details.
    ///
    /// Held in code rather than in a table: unlike the entity list, which follows the
    /// group's companies and must change without a redeploy, this is a closed vocabulary
    /// belonging to the form. Moving it to vms.VisitPurpose is small if it needs to be
    /// editable at the desk.
    /// </summary>
    private static readonly string[] Purposes =
    [
        "Meetings", "Submission", "Delivery", "Collection",
        "Visit", "Interview", "Enquiry", "Payments",
    ];

    private const string OtherPurpose = "Other";

    private List<DiEntity> entities = [];
    private int entityId;
    private string personToVisit = string.Empty;
    private string purpose = string.Empty;
    private string purposeOther = string.Empty;

    /// <summary>The person picked from the list, or null when the name was simply typed.</summary>
    private Person? host;

    private bool searchAllEntities;

    /// <summary>True while the confirmation is up. Saving is only reachable through it.</summary>
    private bool confirming;

    private ElementReference confirmButton;
    private bool confirmNeedsFocus;

    /// <summary>The toast's text, or null when nothing is being shown.</summary>
    private string? toast;

    /// <summary>
    /// Hides the toast after a few seconds. Cancelled and replaced when a new toast
    /// arrives, so an earlier one cannot dismiss a later one, and on dispose, so a
    /// closed circuit is not rendered into.
    /// </summary>
    private CancellationTokenSource? toastTimer;

    /// <summary>
    /// True when the last search found nobody in the selected entity but would have found
    /// somebody elsewhere - which is the only case worth telling the attendant about.
    /// </summary>
    private bool noMatchInEntity;

    /// <summary>
    /// Runs the host search, narrowed to the selected entity unless told otherwise.
    ///
    /// Matches anywhere in the name, not just the start: a visitor asking for "Kamau"
    /// should find Emma Kamau. Email is matched too, since it is often what the visitor
    /// was given. Capped, because a suggestion list nobody can read is no help.
    /// </summary>
    private async Task<IReadOnlyList<Person>> SearchPeople(string term)
    {
        noMatchInEntity = false;

        await using var db = await DbFactory.CreateDbContextAsync();

        /* The term is a LIKE pattern, so its own pattern characters have to be neutralised
           - not against injection, which EF's parameters already handle, but because
           typing a single % matches every person in the list and a _ matches any
           character. A receptionist typing a name is not writing a pattern. */
        var pattern = LikeLiteral(term);

        var all = db.People.Where(p => p.IsActive
                                   && (EF.Functions.Like(p.DisplayName, $"%{pattern}%", LikeEscape)
                                    || (p.Email != null && EF.Functions.Like(p.Email, $"{pattern}%", LikeEscape))));

        if (searchAllEntities || entityId == 0)
        {
            return await all.OrderBy(p => p.DisplayName).Take(12).ToListAsync();
        }

        var withinEntity = await all.Where(p => p.DiEntityId == entityId)
                                    .OrderBy(p => p.DisplayName)
                                    .Take(12)
                                    .ToListAsync();

        if (withinEntity.Count > 0) return withinEntity;

        // Nothing here; say so only if widening would actually help.
        noMatchInEntity = await all.AnyAsync();
        return withinEntity;
    }

    private void SearchEverywhere()
    {
        searchAllEntities = true;
        noMatchInEntity = false;
    }

    /// <summary>
    /// A change of scope invalidates the pick: the name in the box may no longer be the
    /// person the attendant chose from the narrower list.
    /// </summary>
    private void ClearHost()
    {
        host = null;
        noMatchInEntity = false;
    }

    /// <summary>
    /// Everything the visit needs before it can be written: an entity, a host, a purpose,
    /// and - when the purpose is Other - what that other purpose actually was. Recording
    /// "Other" and nothing else would be worse than recording nothing.
    /// </summary>
    private bool VisitIsComplete =>
        entityId != 0
        && !string.IsNullOrWhiteSpace(personToVisit)
        && !string.IsNullOrWhiteSpace(purpose)
        && (purpose != OtherPurpose || !string.IsNullOrWhiteSpace(purposeOther));

    /// <summary>Clears the detail when the purpose moves off Other, so a stale note cannot be saved.</summary>
    private void PurposeChanged()
    {
        if (purpose != OtherPurpose) purposeOther = string.Empty;
    }
    private VisitorEntry? saved;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntities();
        await CheckReader();
    }

    /// <summary>
    /// Puts the keyboard in the dialog as it opens, so Enter confirms and Escape backs
    /// out without reaching for the mouse - and so the confirmation is not a step that
    /// slows a queue down.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!confirmNeedsFocus) return;

        confirmNeedsFocus = false;
        try
        {
            await confirmButton.FocusAsync();
        }
        catch
        {
            // The dialog closed between render and focus; nothing to focus.
        }
    }

    private void AskToSave()
    {
        confirming = true;
        confirmNeedsFocus = true;
    }

    private void OnConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") confirming = false;
    }

    private void DismissToast()
    {
        toastTimer?.Cancel();
        toast = null;
    }

    /// <summary>
    /// Shows a toast and takes it away again after a moment. Deliberately not awaited by
    /// the caller: the message is feedback, not part of the save.
    /// </summary>
    private void ShowToast(string text)
    {
        toastTimer?.Cancel();
        toastTimer?.Dispose();
        toastTimer = new CancellationTokenSource();
        var token = toastTimer.Token;

        toast = text;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(5), token);
                await InvokeAsync(() =>
                {
                    toast = null;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
                // Replaced by a newer toast, dismissed by hand, or the circuit is gone.
            }
        });
    }

    /// <summary>
    /// The reader's name as a person would write it.
    ///
    /// PC/SC hands back "0_ACS ACR39U ICC Reader 0" - an index, the name, and the slot
    /// number. Correct, and not what belongs on a screen a visitor is looking at.
    /// </summary>
    private static string? TidyReaderName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return name;

        var tidied = System.Text.RegularExpressions.Regex.Replace(name.Trim(), @"^\d+_", string.Empty);
        tidied = System.Text.RegularExpressions.Regex.Replace(tidied, @"\s+\d+$", string.Empty);

        // If stripping left nothing useful, the raw name is better than a blank.
        return tidied.Length > 0 ? tidied : name;
    }

    private const string LikeEscape = "\\";

    /// <summary>
    /// Escapes the characters T-SQL's LIKE treats as pattern syntax, so a typed name is
    /// matched as the text it is. Paired with the ESCAPE clause on each Like call.
    /// </summary>
    private static string LikeLiteral(string term) => term
        .Replace(LikeEscape, LikeEscape + LikeEscape)
        .Replace("%", LikeEscape + "%")
        .Replace("_", LikeEscape + "_")
        .Replace("[", LikeEscape + "[");

    /// <summary>
    /// Fits a value to its column, and says so in the log when it had to cut.
    ///
    /// Silent truncation of a visitor record is not acceptable - the record is the point -
    /// but neither is a database error at the desk. So it saves, and the log carries the
    /// fact that something arrived longer than any real card produces.
    /// </summary>
    private string? Fit(string? value, int maximum, string field)
    {
        var result = FieldLengths.Clamp(value, maximum, out var cut);

        if (cut)
        {
            Logger.LogWarning(
                "Visitor entry {Field} was {Length} characters and the column holds {Maximum}, so it " +
                "was cut. Nothing a real Emirates ID returns is that long.",
                field, value!.Length, maximum);
        }

        return result;
    }

    /// <summary>The ID number reduced to digits, for the length check and for storage.</summary>
    private string IdDigits =>
        new(manual.IdNumber.Where(char.IsAsciiDigit).ToArray());

    /// <summary>The two fields a visitor entry cannot be written without.</summary>
    private bool ManualIsComplete =>
        IdDigits.Length > 0 && !string.IsNullOrWhiteSpace(manual.FullNameEnglish);

    /// <summary>
    /// Reads the card through the agent on the desk, and hands the response straight to
    /// the server to be verified.
    ///
    /// The browser returns one thing: the signed XML. Everything the screen then shows was
    /// parsed on this side of the circuit, from a document whose signature and request ID
    /// were checked here - see AgentCardReader. A browser-parsed field would make the
    /// signature decorative, so none is accepted.
    /// </summary>
    private async Task<CardData> ReadThroughAgentAsync(IProgress<string> progress)
    {
        var module = await AgentModule();

        /* Issued here, spent here. The gateway stamps it into the response, so a document
           from an earlier visitor cannot be replayed into this check-in. */
        var requestId = AgentReader.BeginRead();

        progress.Report("Reading the card at the desk…");

        /* Generous: the timeout is for an agent that has stopped answering, not for a
           slow chip - and a read that is cut off looks to the attendant exactly like a
           card that will not read. */
        var result = await module.InvokeAsync<AgentReadResult>(
            "read", TimeSpan.FromSeconds(120), AgentReader.Options.ForBrowser(), requestId);

        progress.Report("Checking the response…");

        return AgentReader.Complete(requestId, result.Xml);
    }

    /// <summary>
    /// Imported on first use rather than at start-up: the report screen has no use for
    /// 120 KB of card-reading JavaScript, and in in-process mode nor does this one.
    /// </summary>
    private async Task<IJSObjectReference> AgentModule() =>
        agentModule ??= await JS.InvokeAsync<IJSObjectReference>(
            /* Cache-busted like the stylesheet. A module import is cached hard, and a desk
               quietly running last week's copy of the reader code is a bug that costs an
               afternoon before anyone suspects the browser - it has already happened once
               on this project. */
            "import", $"./js/card-agent.js?v={BuildInfo.CacheTag}");

    /// <summary>
    /// Switches to typing the details in. A blank CardData is used as the form's model so
    /// the rest of the flow - visit details, save, the report - needs no second path;
    /// captureMethod is what keeps the two kinds of record apart.
    /// </summary>
    private void StartManualEntry()
    {
        manual = new CardData();
        card = manual;
        captureMethod = "Manual";
        message = null;
        step = 1;
    }

    /// <summary>
    /// Re-reads the entity list on the way in, so one added to the database while this tab
    /// sat open is on offer without a page refresh.
    /// </summary>
    private async Task ToVisitDetails()
    {
        await LoadEntities();
        step = 2;
    }

    /// <summary>
    /// Reads the dropdown's options from the Entity table. Active rows only: an entity
    /// that has been retired keeps its visitor history but is no longer offered.
    /// </summary>
    private async Task LoadEntities()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            entities = await db.DiEntities
                .Where(e => e.IsActive)
                .OrderBy(e => e.Name)
                .ToListAsync();

            // A selection made before a reload may no longer be on offer.
            if (entityId != 0 && entities.TrueForAll(e => e.Id != entityId)) entityId = 0;
        }
        catch (Exception ex)
        {
            entities = [];
            Fail($"Could not load the entity list: {ex.Message}");
        }
    }

    private async Task CheckReader()
    {
        message = null;
        readerState = UsesAgent ? await ProbeAgentAsync() : await Reader.GetStateAsync();
    }

    /// <summary>
    /// Asks the browser what the desk has. In agent mode the reader is on the attendant's
    /// machine, so only the browser can answer - the server has no way to see it.
    /// </summary>
    private async Task<ReaderState> ProbeAgentAsync()
    {
        try
        {
            var module = await AgentModule();

            var probe = await module.InvokeAsync<AgentProbe>(
                "probe", TimeSpan.FromSeconds(30), AgentReader.Options.ForBrowser());

            var (licence, licenceDays) = CardReaderService.ReadLicence(probe.LicenceExpiryText());

            /* Set here, where the two states are still distinguishable. "No agent on this
               PC" and "an agent, but no card in the reader" both leave Available false,
               and only the first one means retrying is pointless. */
            agentMissing = !probe.AgentAvailable;

            return new ReaderState
            {
                Available = probe is { AgentAvailable: true, CardPresent: true },
                ReaderName = probe.ReaderName,
                Detail = probe.Detail ?? "The agent gave no detail.",
                ToolkitVersion = probe.ToolkitVersion,
                LicenceExpiry = licence,
                LicenceDaysRemaining = licenceDays,
            };
        }
        catch (JSDisconnectedException)
        {
            // The browser has gone. There is nobody to show a state to.
            return new ReaderState { Available = false, Detail = "The browser disconnected." };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Probing the desk's ICP agent failed");

            /* The probe itself failing is not evidence either way about the agent, so it
               does not claim the desk cannot read cards - it says what went wrong and
               leaves Read Card available. */
            return new ReaderState { Available = false, Detail = Readable(ex) };
        }
    }

    /// <summary>
    /// The first line of an exception message.
    ///
    /// A JSException carries the browser's stack trace in its Message: the text, then
    /// "Error:" and the same text again, then the file and line it was thrown from. HTML
    /// collapses the newlines, so it reaches the desk as one long duplicated sentence
    /// ending in a URL. The first line is the part that was written for a person; the
    /// rest is in the log, where it belongs.
    /// </summary>
    private static string Readable(Exception exception)
    {
        var first = exception.Message.Split('\n')[0].Trim();
        return first.Length > 0 ? first : exception.Message;
    }

    private async Task ReadCard()
    {
        reading = true;
        readingPhase = "Starting…";
        message = null;

        /* Progress<T> posts its callbacks to the circuit's dispatcher, so setting state
           and re-rendering from here is safe. */
        var progress = new Progress<string>(phase =>
        {
            readingPhase = phase;
            StateHasChanged();
        });

        try
        {
            card = UsesAgent ? await ReadThroughAgentAsync(progress) : await Reader.ReadAsync(progress);

            /* An agent read the server could not verify is not the same record as one it
               could, and the report must not present them as if they were. In-process is
               excluded deliberately: there an unsigned response still came from the
               toolkit inside this process, so the missing signature says something about
               ICP's offline configuration, not about the data. */
            captureMethod = UsesAgent && card.SignatureWarning is not null
                ? "CardReaderUnverified"
                : "CardReader";
            failedReads = 0;
            agentMissing = false;
            step = 1;
        }
        catch (Exception ex)
        {
            failedReads++;
            Logger.LogWarning(ex, "Card read failed (attempt {Attempt})", failedReads);
            /* Re-probed before the message is set, because CheckReader clears it: the
               attendant needs the reason the read failed, not the state that follows. */
            await CheckReader();

            /* A desk with no agent has already been told, in the reader panel and in the
               offer of manual entry. A third copy in the error banner is noise with a
               visitor waiting. */
            if (!agentMissing) Fail(Readable(ex));
        }
        finally
        {
            reading = false;
            readingPhase = null;
        }
    }

    private async Task Save()
    {
        if (card is null) return;

        saving = true;
        message = null;
        try
        {
            var entry = new VisitorEntry
            {
                /* Every string is fitted to its column on the way in. Nothing a real card
                   returns comes near these lengths, so this is not tidying: it is the
                   boundary. In agent mode the card data arrives from a browser, and while
                   ICP's responses are unsigned the server cannot tell a real read from a
                   crafted one - so an oversized field is a thing that can happen, and it
                   must produce a record rather than a truncation error at the desk. */

                /* Digits only, so a typed record and a chip read of the same person land
                   on the same IdNumber - which is indexed, and is how a repeat visitor is
                   found. The chip returns it unpunctuated; a person types the dashes. */
                IdNumber = Fit(IsManual ? IdDigits : card.IdNumber, FieldLengths.IdNumber, "ID number") ?? string.Empty,
                CardNumber = Fit(card.CardNumber, FieldLengths.CardNumber, "card number"),
                Photo = card.Photo,
                IdType = Fit(card.IdType, FieldLengths.CardField, "ID type"),
                IssueDate = Fit(card.IssueDate, FieldLengths.CardField, "issue date"),
                ExpiryDate = Fit(card.ExpiryDate, FieldLengths.CardField, "expiry date"),
                FullNameEnglish = Fit(card.FullNameEnglish, FieldLengths.Name, "name") ?? string.Empty,
                FullNameRaw = Fit(card.FullNameRaw, FieldLengths.Name, "raw name"),
                FullNameArabic = Fit(card.FullNameArabic, FieldLengths.Name, "Arabic name"),
                TitleEnglish = Fit(card.TitleEnglish, FieldLengths.CardField, "title"),
                Gender = Fit(card.Gender, FieldLengths.CardField, "gender"),
                DateOfBirth = Fit(card.DateOfBirth, FieldLengths.CardField, "date of birth"),
                NationalityEnglish = Fit(card.NationalityEnglish, FieldLengths.CardField, "nationality"),
                NationalityCode = Fit(card.NationalityCode, FieldLengths.CardField, "nationality code"),
                PlaceOfBirthEnglish = Fit(card.PlaceOfBirthEnglish, FieldLengths.CardField, "place of birth"),
                AddressEmirate = Fit(card.AddressEmirate, FieldLengths.CardField, "emirate"),
                AddressCity = Fit(card.AddressCity, FieldLengths.CardField, "city"),
                AddressArea = Fit(card.AddressArea, FieldLengths.CardField, "area"),
                AddressStreet = Fit(card.AddressStreet, FieldLengths.CardField, "street"),
                AddressBuilding = Fit(card.AddressBuilding, FieldLengths.CardField, "building"),
                AddressPoBox = Fit(card.AddressPoBox, FieldLengths.CardField, "PO box"),
                AddressPhone = Fit(card.AddressPhone, FieldLengths.CardField, "phone"),
                AddressMobile = Fit(card.AddressMobile, FieldLengths.CardField, "mobile"),
                AddressEmail = Fit(card.AddressEmail, FieldLengths.Email, "email"),
                DiEntityId = entityId,
                PersonToVisit = Fit(personToVisit.Trim(), FieldLengths.PersonToVisit, "person to visit") ?? string.Empty,
                PersonToVisitId = host?.Id,
                PersonToVisitTitle = Fit(host?.Title, FieldLengths.Title, "host title"),
                PersonToVisitEmail = Fit(host?.Email, FieldLengths.Email, "host email"),
                PersonToVisitCompany = Fit(host?.CompanyName, FieldLengths.Company, "host company"),
                Purpose = Fit(purpose, FieldLengths.Purpose, "purpose") ?? string.Empty,
                PurposeOther = purpose == OtherPurpose
                    ? Fit(purposeOther.Trim(), FieldLengths.PurposeOther, "purpose details")
                    : null,
                RecordedAtUtc = DateTimeOffset.UtcNow,
                CaptureMethod = captureMethod,
            };

            await using var db = await DbFactory.CreateDbContextAsync();
            db.VisitorEntries.Add(entry);
            await db.SaveChangesAsync();

            saved = entry;
            confirming = false;
            step = 3;

            ShowToast("Visitor has been saved.");
        }
        catch (Exception ex)
        {
            Fail($"Could not save the entry: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Restart()
    {
        step = 0;
        card = null;
        saved = null;
        entityId = 0;
        personToVisit = string.Empty;
        purpose = string.Empty;
        purposeOther = string.Empty;
        host = null;
        searchAllEntities = false;
        noMatchInEntity = false;
        message = null;

        // A fresh visitor starts from the reader, and gets its own three attempts.
        captureMethod = "CardReader";
        failedReads = 0;

        await CheckReader();
    }

    private void Fail(string text)
    {
        message = text;
        messageKind = "critical";
    }

    private static string ToDataUrl(byte[] bytes, string mime) =>
        $"data:{mime};base64,{Convert.ToBase64String(bytes)}";

    public async ValueTask DisposeAsync()
    {
        toastTimer?.Cancel();
        toastTimer?.Dispose();

        if (agentModule is not null)
        {
            /* A circuit that has already gone cannot be told to drop a module, and
               throwing out of disposal would bury whatever actually ended the circuit. */
            try { await agentModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Disposing the card agent module failed"); }
        }
    }

    private static string ToGst(DateTimeOffset instant) =>
        instant.ToOffset(TimeSpan.FromHours(4)).ToString("dd MMM yyyy HH:mm:ss");
}
