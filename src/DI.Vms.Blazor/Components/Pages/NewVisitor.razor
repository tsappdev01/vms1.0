@page "/"
@rendermode InteractiveServer
@inject CardReaderService Reader
@inject ILogger<NewVisitor> Logger
@inject IDbContextFactory<VmsDbContext> DbFactory

<PageTitle>New Visitor &middot; DI VMS</PageTitle>

<h1>New Visitor</h1>
<p class="page-sub">Read the Emirates ID, name the entity and the host, and stamp the entry.</p>

<div class="steps">
    @for (var i = 0; i < Steps.Length; i++)
    {
        var n = i;
        <div class="step @(n == step ? "active" : "") @(n < step ? "done" : "")">
            <span class="num">@(n < step ? "✓" : (n + 1).ToString())</span>@Steps[n]
        </div>
    }
</div>

@if (message is not null)
{
    <div class="banner @messageKind"><span>@message</span></div>
}

@* ---------------------------------------------------- 1. Insert and read the card *@

@if (step == 0)
{
    <section class="card">
        <div class="hero">
            <div class="hero-art">
                @* An Emirates ID above a contact reader, over a Dubai skyline. Drawn here
                   rather than shipped as an image so it follows the theme. *@
                <svg viewBox="0 0 340 260" role="img"
                     aria-label="An Emirates ID card resting on a card reader, against a Dubai skyline">
                    <g stroke="var(--accent)" fill="none" opacity=".18" stroke-width="1.4"
                       stroke-linejoin="round">
                        <path d="M28 196V150l10-14 10 14v46" />
                        <path d="M62 196v-58l14-10 14 10v58" />
                        <path d="M170 196V54l7-30 7 30v142" />
                        <path d="M164 196v-96l6-8 6 8" />
                        <path d="M252 196v-72l16-12 16 12v72" />
                        <path d="M296 196v-44l10-8 10 8v44" />
                    </g>

                    <line x1="16" y1="196" x2="324" y2="196" stroke="var(--border)" stroke-width="1.4" />

                    <!-- reader -->
                    <rect x="112" y="170" width="116" height="26" rx="5"
                          fill="var(--surface-2)" stroke="var(--text-muted)" stroke-width="1.3" />
                    <rect x="126" y="176" width="88" height="5" rx="2.5"
                          fill="var(--status-good)" opacity=".85" />
                    <path d="M170 170v-8" stroke="var(--text-muted)" stroke-width="1.3" />

                    <!-- card -->
                    <g transform="rotate(-7 170 104)">
                        <rect x="86" y="58" width="168" height="96" rx="9"
                              fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5" />
                        <rect x="96" y="94" width="30" height="24" rx="4"
                              fill="var(--di-gold-tint)" stroke="var(--di-gold)" stroke-width="1.3" />
                        <path d="M104 100v12M112 100v12M120 100v12" stroke="var(--di-gold)" stroke-width="1.1" />
                        <rect x="196" y="72" width="48" height="60" rx="5"
                              fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.2" />
                        <circle cx="220" cy="94" r="10" fill="var(--border)" />
                        <path d="M206 126a14 14 0 0 1 28 0" fill="var(--border)" />
                        <g stroke="var(--border)" stroke-width="4" stroke-linecap="round">
                            <path d="M98 74h44" />
                            <path d="M98 128h58" />
                            <path d="M136 100h48" />
                            <path d="M136 112h34" />
                        </g>
                    </g>
                </svg>
            </div>

            <div class="hero-panel">
                @if (readerState is null)
                {
                    <p class="lead">Checking the reader…</p>
                }
                else
                {
                    <span class="ready @(readerState.Available ? "" : "waiting")">
                        @if (readerState.Available)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 4.5-5" />
                            </svg>
                            <text>Ready to read</text>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" />
                            </svg>
                            <text>Waiting for a card</text>
                        }
                    </span>

                    <p class="lead">Insert the Emirates ID into the reader.</p>
                    <p class="muted">Chip side first, then read the card.</p>

                    <div class="reader-state @(readerState.Available ? "ok" : "waiting")">
                        <span class="icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="13" width="20" height="8" rx="2" />
                                <path d="M6 17h10" />
                                <rect x="7" y="3" width="10" height="8" rx="1.5" />
                            </svg>
                        </span>
                        <span>
                            <strong>@(readerState.ReaderName ?? "No reader detected")</strong>
                            <span>@readerState.Detail</span>
                        </span>
                    </div>

                    @if (readerState.ToolkitVersion is not null || readerState.LicenceExpiry is not null)
                    {
                        <p class="hint">
                            Toolkit @(readerState.ToolkitVersion ?? "—")
                            @if (readerState.LicenceExpiry is not null)
                            {
                                <text> &middot; licence to @readerState.LicenceExpiry</text>
                            }
                        </p>
                    }
                }

                <div class="actions">
                    <button class="primary large" @onclick="ReadCard" disabled="@reading">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="17" height="17" aria-hidden="true">
                            <path d="M4 8a12 12 0 0 1 0 8M8.5 6a16 16 0 0 1 0 12" />
                            <circle cx="15" cy="12" r="2.5" />
                            <path d="M19 9.5a5 5 0 0 1 0 5" />
                        </svg>
                        @(reading ? "Reading card…" : "Read Card")
                    </button>
                    <button @onclick="CheckReader" disabled="@reading">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="16" height="16" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" /><path d="M16 16l4.5 4.5" />
                        </svg>
                        Check reader
                    </button>
                </div>

                <div class="tip">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 18h6M10 21h4" />
                        <path d="M12 3a6 6 0 0 1 3.5 10.9V15h-7v-1.1A6 6 0 0 1 12 3Z" />
                    </svg>
                    <span><b>Tip.</b> If the card is not detected, wipe the chip contacts and reseat it.</span>
                </div>
            </div>
        </div>
    </section>

    <div class="assurances">
        <div class="assurance">
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M6 10h4M6 14h7" /><circle cx="17" cy="12" r="2.5" />
                </svg>
            </span>
            <div>
                <strong>Straight from the chip</strong>
                <p>Name, nationality, photograph and signature are read off the card, not transcribed.</p>
            </div>
        </div>
        <div class="assurance">
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
                </svg>
            </span>
            <div>
                <strong>Two fields to fill</strong>
                <p>Everything else is already on the card. The attendant names the entity and the host.</p>
            </div>
        </div>
        <div class="assurance">
            <span class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                </svg>
            </span>
            <div>
                <strong>Stamped on save</strong>
                <p>Each entry keeps the moment it was recorded, stored in UTC and shown in GST.</p>
            </div>
        </div>
    </div>
}

@* ------------------------------------------- 2. Visitor information from the chip *@

else if (step == 1 && card is not null)
{
    @* The identity strip answers "who am I looking at" before the field-by-field
       readout does. Same values, read in the order the attendant needs them. *@
    <section class="card">
        <div class="identity">
            @if (card.Photo is { Length: > 0 })
            {
                <img class="identity-photo" src="@ToDataUrl(card.Photo, "image/jpeg")" alt="Cardholder photograph" />
            }
            else
            {
                <div class="identity-photo placeholder">No photo on card</div>
            }

            <div class="identity-who">
                <h2 class="identity-name">@card.FullNameEnglish</h2>
                @if (!string.IsNullOrWhiteSpace(card.FullNameArabic))
                {
                    <p class="identity-name-ar" dir="rtl">@card.FullNameArabic</p>
                }
                <div class="identity-facts">
                    <span><span class="k">ID</span> <span class="mono">@card.IdNumber</span></span>
                    @if (!string.IsNullOrWhiteSpace(card.NationalityEnglish))
                    {
                        <span><span class="k">Nationality</span> @card.NationalityEnglish</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(card.ExpiryDate))
                    {
                        <span><span class="k">Card expires</span> <span class="mono">@card.ExpiryDate</span></span>
                    }
                </div>
            </div>

            <div class="identity-sig">
                <div class="field-label">Signature</div>
                @if (signatureDataUrl is not null)
                {
                    <img class="signature" src="@signatureDataUrl" alt="Cardholder signature" />
                }
                else
                {
                    <div class="signature placeholder">Not on card</div>
                }
            </div>
        </div>

        <div class="card-body">
            <div class="grid-3">
                <Field Label="ID Number" Value="@card.IdNumber" Mono="true" />
                <Field Label="Card Number" Value="@card.CardNumber" Mono="true" />
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-head"><h2>Non-Modifiable Data</h2></div>
        <div class="card-body grid-3">
            <Field Label="ID Type" Value="@card.IdType" />
            <Field Label="Issue Date" Value="@card.IssueDate" />
            <Field Label="Expiry Date" Value="@card.ExpiryDate" />
            <Field Label="Full Name (English)" Value="@card.FullNameEnglish" />
            <Field Label="Full Name (Arabic)" Value="@card.FullNameArabic" Rtl="true" />
            <Field Label="Nationality (English)" Value="@card.NationalityEnglish" />
            <Field Label="Gender" Value="@card.Gender" />
            <Field Label="Date of Birth" Value="@card.DateOfBirth" />
            <Field Label="Nationality Code" Value="@card.NationalityCode" />
            <Field Label="Title (English)" Value="@card.TitleEnglish" />
            <Field Label="Place of Birth (English)" Value="@card.PlaceOfBirthEnglish" />
        </div>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Home Address</h2>
            @if (card.HasNoPostalAddress)
            {
                <span class="sub">No postal address held on this card</span>
            }
        </div>
        <div class="card-body grid-3">
            <Field Label="Emirate" Value="@card.AddressEmirate" />
            <Field Label="City" Value="@card.AddressCity" />
            <Field Label="Area" Value="@card.AddressArea" />
            <Field Label="Street" Value="@card.AddressStreet" />
            <Field Label="Building" Value="@card.AddressBuilding" />
            <Field Label="PO Box" Value="@card.AddressPoBox" />
            <Field Label="Phone" Value="@card.AddressPhone" />
            <Field Label="Mobile" Value="@card.AddressMobile" Highlight="true" />
            <Field Label="Email" Value="@card.AddressEmail" Highlight="true" />
        </div>
    </section>

    @if (card.SignatureWarning is not null)
    {
        <div class="banner warn"><strong>Note.</strong><span>@card.SignatureWarning</span></div>
    }

    <div class="actions">
        <button @onclick="Restart">Read a different card</button>
        <button class="primary" @onclick="ToVisitDetails">
            Continue
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
        </button>
    </div>
}

@* --------------------------------------------- 3. Entity and person, then save *@

else if (step == 2 && card is not null)
{
    <section class="card narrow">
        <div class="card-head"><h2>Visit Details</h2></div>
        <div class="card-body">
            <div class="readout">
                <dt>Visitor</dt><dd>@card.FullNameEnglish</dd>
                <dt>ID Number</dt><dd class="mono">@card.IdNumber</dd>
            </div>

            <div class="field mt">
                <label for="entity">Entity being visited</label>
                @* The list is the Entity table, active rows only, read fresh from the
                   database each time this screen opens. *@
                @if (entities.Count == 0)
                {
                    <div class="banner warn">
                        <strong>No entities.</strong>
                        <span>
                            The <code>vms.Entity</code> table has no active rows, so there is
                            nothing to choose. The list is maintained in the database, not in
                            the application — run the entity insert script against
                            <code>VMS</code>, then retry.
                        </span>
                    </div>
                    <button @onclick="LoadEntities">Retry</button>
                }
                else
                {
                    <select id="entity" @bind="entityId">
                        <option value="0">Select an entity…</option>
                        @foreach (var e in entities)
                        {
                            <option value="@e.Id">@e.Name</option>
                        }
                    </select>
                }
            </div>

            <div class="field">
                <label for="person">Person to visit</label>
                <input id="person" @bind="personToVisit" @bind:event="oninput"
                       placeholder="Full name of the person being visited" autocomplete="off" />
            </div>

            <div class="actions">
                <button @onclick="() => step = 1">Back</button>
                <button class="primary" @onclick="Save"
                        disabled="@(saving || entityId == 0 || string.IsNullOrWhiteSpace(personToVisit))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                    @(saving ? "Saving…" : "Save entry")
                </button>
            </div>
        </div>
    </section>
}

@* ------------------------------------------------------------------ 4. Saved *@

else if (step == 3 && saved is not null)
{
    <section class="card narrow">
        <div class="card-body">
            <div class="saved-mark">
                <span class="saved-ring">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                </span>
                <span>
                    <strong>Entry saved</strong>
                    <span>The visitor is recorded against the entity and the host.</span>
                </span>
            </div>
            <div class="readout">
                <dt>Reference</dt><dd class="mono">#@saved.Id</dd>
                <dt>Visitor</dt><dd>@saved.FullNameEnglish</dd>
                <dt>ID Number</dt><dd class="mono">@saved.IdNumber</dd>
                <dt>Entity</dt><dd>@entities.FirstOrDefault(e => e.Id == saved.DiEntityId)?.Name</dd>
                <dt>Person to visit</dt><dd>@saved.PersonToVisit</dd>
                <dt>Recorded</dt><dd class="mono">@ToGst(saved.RecordedAtUtc) GST</dd>
            </div>
            <div class="actions">
                <button class="primary" @onclick="Restart">New Visitor</button>
                <a class="button" href="report">View report</a>
            </div>
        </div>
    </section>
}

@code {
    private static readonly string[] Steps = ["Insert Card", "Visitor Information", "Visit Details", "Saved"];

    private int step;
    private bool reading;
    private bool saving;
    private string? message;
    private string messageKind = "";

    private ReaderState? readerState;
    private CardData? card;
    private string? signatureDataUrl;

    private List<DiEntity> entities = [];
    private int entityId;
    private string personToVisit = string.Empty;
    private VisitorEntry? saved;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntities();
        await CheckReader();
    }

    /// <summary>
    /// Re-reads the entity list on the way in, so one added to the database while this tab
    /// sat open is on offer without a page refresh.
    /// </summary>
    private async Task ToVisitDetails()
    {
        await LoadEntities();
        step = 2;
    }

    /// <summary>
    /// Reads the dropdown's options from the Entity table. Active rows only: an entity
    /// that has been retired keeps its visitor history but is no longer offered.
    /// </summary>
    private async Task LoadEntities()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            entities = await db.DiEntities
                .Where(e => e.IsActive)
                .OrderBy(e => e.Name)
                .ToListAsync();

            // A selection made before a reload may no longer be on offer.
            if (entityId != 0 && entities.TrueForAll(e => e.Id != entityId)) entityId = 0;
        }
        catch (Exception ex)
        {
            entities = [];
            Fail($"Could not load the entity list: {ex.Message}");
        }
    }

    private async Task CheckReader()
    {
        readerState = await Reader.GetStateAsync();
        message = null;
    }

    private async Task ReadCard()
    {
        reading = true;
        message = null;
        try
        {
            card = await Reader.ReadAsync();
            signatureDataUrl = ImageConverter.ToDisplayableDataUrl(card.CardSignature, Logger);
            step = 1;
        }
        catch (Exception ex)
        {
            Fail(ex.Message);
            readerState = await Reader.GetStateAsync();
        }
        finally
        {
            reading = false;
        }
    }

    private async Task Save()
    {
        if (card is null) return;

        saving = true;
        message = null;
        try
        {
            var entry = new VisitorEntry
            {
                IdNumber = card.IdNumber,
                CardNumber = card.CardNumber,
                Photo = card.Photo,
                CardSignature = card.CardSignature,
                IdType = card.IdType,
                IssueDate = card.IssueDate,
                ExpiryDate = card.ExpiryDate,
                FullNameEnglish = card.FullNameEnglish,
                FullNameRaw = card.FullNameRaw,
                FullNameArabic = card.FullNameArabic,
                TitleEnglish = card.TitleEnglish,
                Gender = card.Gender,
                DateOfBirth = card.DateOfBirth,
                NationalityEnglish = card.NationalityEnglish,
                NationalityCode = card.NationalityCode,
                PlaceOfBirthEnglish = card.PlaceOfBirthEnglish,
                AddressEmirate = card.AddressEmirate,
                AddressCity = card.AddressCity,
                AddressArea = card.AddressArea,
                AddressStreet = card.AddressStreet,
                AddressBuilding = card.AddressBuilding,
                AddressPoBox = card.AddressPoBox,
                AddressPhone = card.AddressPhone,
                AddressMobile = card.AddressMobile,
                AddressEmail = card.AddressEmail,
                DiEntityId = entityId,
                PersonToVisit = personToVisit.Trim(),
                RecordedAtUtc = DateTimeOffset.UtcNow,
                CaptureMethod = "CardReader",
            };

            await using var db = await DbFactory.CreateDbContextAsync();
            db.VisitorEntries.Add(entry);
            await db.SaveChangesAsync();

            saved = entry;
            step = 3;
        }
        catch (Exception ex)
        {
            Fail($"Could not save the entry: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Restart()
    {
        step = 0;
        card = null;
        signatureDataUrl = null;
        saved = null;
        entityId = 0;
        personToVisit = string.Empty;
        message = null;
        await CheckReader();
    }

    private void Fail(string text)
    {
        message = text;
        messageKind = "critical";
    }

    private static string ToDataUrl(byte[] bytes, string mime) =>
        $"data:{mime};base64,{Convert.ToBase64String(bytes)}";

    private static string ToGst(DateTimeOffset instant) =>
        instant.ToOffset(TimeSpan.FromHours(4)).ToString("dd MMM yyyy HH:mm:ss");
}
