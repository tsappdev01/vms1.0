@page "/report"
@rendermode InteractiveServer
@attribute [Authorize(Policy = VmsRoles.CanViewReport)]
@inject IDbContextFactory<VmsDbContext> DbFactory
@inject IJSRuntime Js

<PageTitle>Visitor Report &middot; DI VMS</PageTitle>

<h1>Visitor Details by Entity</h1>
<p class="page-sub">All recorded information, with the date-time stamp of each entry.</p>

@if (error is not null)
{
    <div class="banner critical"><strong>Could not load.</strong><span>@error</span></div>
}

<div class="toolbar">
    <div class="field">
        <label for="from">From</label>
        <input id="from" type="date" @bind="from" />
    </div>
    <div class="field">
        <label for="to">To</label>
        <input id="to" type="date" @bind="to" />
    </div>
    <div class="field grow">
        <label for="filter-entity">Entity</label>
        <select id="filter-entity" @bind="entityId">
            <option value="0">All entities</option>
            @foreach (var e in entities)
            {
                <option value="@e.Id">@e.Name</option>
            }
        </select>
    </div>
    <button class="primary" @onclick="Load" disabled="@loading">@(loading ? "Loading…" : "Apply")</button>
    <button @onclick="ExportCsv" disabled="@(entries.Count == 0)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
            <path d="M12 3v12M7.5 10.5 12 15l4.5-4.5" />
            <path d="M4 19h16" />
        </svg>
        Export CSV
    </button>
    <button @onclick="Print">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
            <path d="M7 9V4h10v5" />
            <rect x="3" y="9" width="18" height="7" rx="2" />
            <path d="M7 16h10v4H7z" />
        </svg>
        Print / Save as PDF
    </button>
</div>

@if (loading)
{
    <div class="empty">Loading…</div>
}
else if (entries.Count == 0)
{
    <div class="empty">
        <strong>No entries</strong>
        <span>Nothing was recorded between @from.ToString("dd MMM yyyy") and @to.ToString("dd MMM yyyy").</span>
    </div>
}
else
{
    @* On paper the toolbar is gone, so the page would not say what period it covers or
       which entity was chosen - which makes a printed report worthless as a record. *@
    <div class="print-only print-head">
        <div>
            <strong>Visitor Details by Entity</strong>
            <span>@from.ToString("dd MMM yyyy") &ndash; @to.ToString("dd MMM yyyy")
                  &middot; @(entityId == 0 ? "All entities" : entities.FirstOrDefault(e => e.Id == entityId)?.Name)</span>
        </div>
        <span>Printed @DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(4)).ToString("dd MMM yyyy HH:mm") GST</span>
    </div>

    <p class="muted">@entries.Count @(entries.Count == 1 ? "entry" : "entries") across @grouped.Count @(grouped.Count == 1 ? "entity" : "entities").</p>

    @foreach (var group in grouped)
    {
        <section class="card">
            <div class="card-head">
                <h2>@group.Key</h2>
                <span class="sub">@group.Value.Count @(group.Value.Count == 1 ? "visitor" : "visitors")</span>
            </div>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Recorded (GST)</th><th>Person to Visit</th><th>Purpose</th><th>Visitor</th>
                            <th>ID Number</th><th>Card No.</th><th>Nationality</th>
                            <th>Gender</th><th>Date of Birth</th><th>ID Issue</th><th>ID Expiry</th>
                            <th>Mobile</th><th>Contact no.</th><th>Email</th><th>Address</th><th>Signed out</th><th>Stayed</th><th>Source</th><th>Recorded by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in group.Value)
                        {
                            <tr>
                                <td class="mono nowrap">@Gst(v.RecordedAtUtc)</td>
                                <td>@v.PersonToVisit</td>
                                <td class="wrap">@PurposeOf(v)</td>
                                <td class="strong">@v.FullNameEnglish</td>
                                <td class="mono">@v.IdNumber</td>
                                <td class="mono">@Dash(v.CardNumber)</td>
                                <td>@Dash(v.NationalityEnglish)</td>
                                <td>@Dash(v.Gender)</td>
                                <td class="mono">@Dash(v.DateOfBirth)</td>
                                <td class="mono">@Dash(v.IssueDate)</td>
                                <td class="mono">@Dash(v.ExpiryDate)</td>
                                <td class="mono">@Dash(v.AddressMobile)</td>
                                <td class="mono">@Dash(v.ContactMobile)</td>
                                <td>@Dash(v.AddressEmail)</td>
                                <td class="mono nowrap">@(v.SignedOutAtUtc is null ? "still in" : Gst(v.SignedOutAtUtc.Value))</td>
                                <td class="mono nowrap">@Stayed(v)</td>
                                @* The capture cell is the way to the stored card, rather
                                   than a column of its own - the header, body and CSV
                                   counts stay in step, and it is where somebody asking
                                   "what was presented?" is already looking. A card read
                                   always has an image; a manual entry never does. *@
                                <td>
                                    @if (v.CaptureMethod?.StartsWith("CardReader") == true)
                                    {
                                        <a href="/visits/@v.Id/card" target="_blank" rel="noopener">@CaptureLabel(v.CaptureMethod)</a>
                                    }
                                    else
                                    {
                                        @CaptureLabel(v.CaptureMethod)
                                    }
                                </td>
                                <td>@(v.RecordedBy ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    /// <summary>
    /// How a record was captured, in words rather than in the stored token.
    ///
    /// "CardReaderUnverified" is an agent read whose signature the server could not
    /// verify. It is a real chip read and the data is almost certainly the card's - but
    /// it arrived from a browser and nothing proved it, so the report says so rather than
    /// letting it stand beside reads that were.
    /// </summary>
    private static string CaptureLabel(string? method) => method switch
    {
        "CardReader" => "Card",
        "CardReaderUnverified" => "Card (unverified)",
        /* A photograph of a card, read by OCR and checked by its own check digits. Below an
           unverified chip read on purpose: that at least came off a chip. */
        "DigitalCard" => "Digital card (photographed)",
        "Manual" => "Manual",
        null or "" => "—",
        _ => method,
    };

    private List<VisitorEntry> entries = [];
    private List<DiEntity> entities = [];
    private List<KeyValuePair<string, List<VisitorEntry>>> grouped = [];

    private DateOnly from = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-30);
    private DateOnly to = DateOnly.FromDateTime(DateTime.UtcNow);
    private int entityId;

    private bool loading;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        /* Retired entities stay selectable while they still have visits behind them, so a
           report over an earlier period can still be filtered to one. Retired and unused
           means it was never really in the list, and only clutters the filter. */
        entities = await db.DiEntities
            .Where(e => e.IsActive || db.VisitorEntries.Any(v => v.DiEntityId == e.Id))
            .OrderBy(e => e.Name)
            .ToListAsync();
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            // Inclusive of the whole 'to' day, in GST, since that is what a user means by
            // a date range on a report.
            var fromUtc = new DateTimeOffset(from.ToDateTime(TimeOnly.MinValue), TimeSpan.FromHours(4));
            var toUtc = new DateTimeOffset(to.ToDateTime(TimeOnly.MaxValue), TimeSpan.FromHours(4));

            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.VisitorEntries
                .Include(v => v.DiEntity)
                .Where(v => v.RecordedAtUtc >= fromUtc && v.RecordedAtUtc <= toUtc);

            if (entityId != 0)
            {
                query = query.Where(v => v.DiEntityId == entityId);
            }

            entries = await query
                .OrderBy(v => v.DiEntity!.Name)
                .ThenByDescending(v => v.RecordedAtUtc)
                .ToListAsync();

            grouped = entries
                .GroupBy(v => v.DiEntity?.Name ?? "(no entity)")
                .OrderBy(g => g.Key)
                .Select(g => new KeyValuePair<string, List<VisitorEntry>>(g.Key, g.ToList()))
                .ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ExportCsv()
    {
        var lines = new List<string>
        {
            "Visitor Details by Entity",
            $"{from:dd MMM yyyy} to {to:dd MMM yyyy}",
            $"Generated {Gst(DateTimeOffset.UtcNow)} GST",
            string.Empty,
            string.Join(',', new[]
            {
                "Entity", "Recorded (GST)", "Person to Visit", "Host Title", "Host Email",
                "Host Company", "Purpose", "Visitor", "Full Name (Raw)",
                "Full Name (Arabic)", "ID Number", "Card Number", "ID Type", "ID Issue",
                "ID Expiry", "Gender", "Date of Birth", "Nationality", "Nationality Code",
                "Place of Birth", "Emirate", "City", "Area", "Street", "Building", "PO Box",
                "Phone", "Mobile", "Contact No", "Email", "Signed Out (GST)", "Stayed", "Source", "Recorded By", "Signed Out By",
            }.Select(Escape)),
        };

        lines.AddRange(entries.Select(v => string.Join(',', new[]
        {
            v.DiEntity?.Name, Gst(v.RecordedAtUtc), v.PersonToVisit, v.PersonToVisitTitle,
            v.PersonToVisitEmail, v.PersonToVisitCompany, PurposeOf(v), v.FullNameEnglish,
            v.FullNameRaw, v.FullNameArabic, v.IdNumber, v.CardNumber, v.IdType, v.IssueDate,
            v.ExpiryDate, v.Gender, v.DateOfBirth, v.NationalityEnglish, v.NationalityCode,
            v.PlaceOfBirthEnglish, v.AddressEmirate, v.AddressCity, v.AddressArea,
            v.AddressStreet, v.AddressBuilding, v.AddressPoBox, v.AddressPhone,
            v.AddressMobile, v.ContactMobile, v.AddressEmail,
            v.SignedOutAtUtc is null ? "still in" : Gst(v.SignedOutAtUtc.Value), Stayed(v),
            v.CaptureMethod, v.RecordedBy, v.SignedOutBy,
        }.Select(Escape))));

        await Js.InvokeVoidAsync("vms.downloadCsv",
            $"visitor-details-by-entity-{from:yyyy-MM-dd}.csv", string.Join('\n', lines));
    }

    private async Task Print() => await Js.InvokeVoidAsync("window.print");

    /// <summary>
    /// How long the visit lasted, or how long it has run so far.
    ///
    /// An open visit is not blank: blank reads as missing data, and "still in" after a
    /// duration is the thing somebody scanning the column is actually looking for.
    /// </summary>
    private static string Stayed(VisitorEntry v)
    {
        var span = (v.SignedOutAtUtc ?? DateTimeOffset.UtcNow) - v.RecordedAtUtc;

        if (span < TimeSpan.Zero) return "—";

        var text = span < TimeSpan.FromHours(1) ? $"{(int)span.TotalMinutes} min"
            : span < TimeSpan.FromDays(1) ? $"{(int)span.TotalHours}h {span.Minutes:D2}m"
            : $"{(int)span.TotalDays}d {span.Hours}h";

        return v.SignedOutAtUtc is null ? $"{text} so far" : text;
    }

    private static string Gst(DateTimeOffset instant) =>
        instant.ToOffset(TimeSpan.FromHours(4)).ToString("dd MMM yyyy HH:mm:ss");

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    /// <summary>
    /// The purpose, with the typed detail appended when it was "Other". One column, so
    /// grouping by purpose still works while the detail is not lost.
    /// </summary>
    private static string PurposeOf(VisitorEntry v) =>
        string.IsNullOrWhiteSpace(v.PurposeOther)
            ? Dash(v.Purpose)
            : $"{v.Purpose} — {v.PurposeOther}";

    private static string? PostalAddress(VisitorEntry v)
    {
        var parts = new[] { v.AddressBuilding, v.AddressStreet, v.AddressArea, v.AddressCity, v.AddressEmirate }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        return string.Join(", ", parts);
    }

    /// <summary>
    /// RFC 4180 quoting, plus neutralising values a spreadsheet would treat as a formula:
    /// a name beginning with '=' must not execute when the export is opened.
    /// </summary>
    private static string Escape(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;

        var v = value;
        if (v[0] is '=' or '+' or '-' or '@' or '\t' or '\r') v = "'" + v;

        return v.Contains(',') || v.Contains('"') || v.Contains('\n') || v.Contains('\r')
            ? '"' + v.Replace("\"", "\"\"") + '"'
            : v;
    }
}
