# Serve screens from in-memory fixtures instead of the API.
# Leave true until DI.Vms.Api exists.
VITE_USE_MOCK=true

# Base URL of DI.Vms.Api. Used when VITE_USE_MOCK=false.
VITE_API_URL=https://localhost:7001

# Card reader:
#   simulator (default) - no hardware needed
#   bridge              - DI.Vms.CardBridge running on the reception machine
#   eida                - ICP JavaScript agent over WebSocket (not wired up)
VITE_CARD_READER=simulator
