{
  // Copy to appsettings.Production.json in the app's folder on UATWEB01 and edit.
  // appsettings.Production.json is gitignored: it holds this machine's paths and, if
  // Windows authentication is not used, a database credential.
  //
  // This is the CENTRAL SERVER template - the app on UATWEB01, the card reader on each
  // reception desk, ICP's agent bridging the two. docs/deployment.md is the runbook.

  "ConnectionStrings": {
    // SQL Server is on this same machine, so this stays local. The app pool identity
    // needs a login - db/006_grant_app_login.sql, with @Login set to the app pool.
    "Vms": "Server=localhost;Database=VMS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  // Entra ID sign-in. The client secret is a credential: this file is gitignored and
  // should be readable only by the app pool identity and administrators. Better still,
  // replace it with a certificate - see docs/entra-id-setup.md.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "dubaiinvestments.com",
    "TenantId": "<directory (tenant) ID from the app registration>",
    "ClientId": "<application (client) ID from the app registration>",
    "ClientSecret": "<client secret value - not the secret ID>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "Toolkit": {
    // Agent: the reader is on the attendant's PC, not here. UATWEB01 has no reader and
    // InProcess would look for one, find nothing, and blame the card.
    "Mode": "Agent",

    "Agent": {
      // false, and measured rather than assumed. The agent installed by
      // ICAToolkitService.msi serves PLAIN ws:// unless it is given a TLS certificate
      // (the installer's "Show TLS certificate fields"), and ICP ships none. A browser
      // will not open a plain ws:// socket from an HTTPS page - except to an origin it
      // already trusts, and the loopback address is one. So https://vms.dipark.com
      // reaches ws://127.0.0.1:9004 and the read works with no certificate anywhere.
      //
      // Set this true only after giving the agent a certificate for
      // toolkitagent.emiratesid.ae on every desk.
      "TlsEnabled": false,

      // MUST stay blank while TlsEnabled is false. Blank means the literal 127.0.0.1,
      // and the literal address is what buys the exemption above: the mixed-content
      // check reads the host as written, so toolkitagent.emiratesid.ae is blocked even
      // though it resolves to 127.0.0.1.
      "HostName": "",

      // Passed to the toolkit on the desk, newline-separated "key = value" - not JSON.
      // Normally blank: the agent carries its own config, and the paths in it are the
      // desk's, not this server's.
      //
      // "read_publicdata_offline = false\n" here asks for an ONLINE read. It matters:
      // an offline read never calls ICP's Validation Gateway, and the gateway is what
      // signs the response - so offline reads come back unsigned and the server has
      // nothing to verify. See docs/deployment.md, "Unsigned responses".
      "ToolkitConfig": "",

      "DebugEnabled": false,

      // THE ONE SETTING THAT MAKES THIS MODE SAFE. A card read now arrives from a
      // browser, and the certificate that signed it travels inside it - so a signature
      // that verifies proves nothing until the signer is one you named here.
      //
      // Leave it empty and reads still work, each marked with a warning, and the first
      // one logs the thumbprint to paste in. Fill it in before you trust the data.
      "TrustedSignerThumbprints": [],

      // Refuse a read whose signature does not verify. Leave true. False is a deliberate
      // decision that a browser-supplied read is a claim the server cannot test - taken
      // only if it turns out the agent's responses are not signed at all, and weighed
      // against the alternative, which is card reading off and every visitor typed in.
      "RequireSignature": true,

      "MaximumResponseAge": "00:10:00"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": { "Default": "Warning" }
    }
  }

  // No Kestrel section: under IIS the binding belongs to the site, not to the app.
  // Bind HTTPS only - Entra will not redirect back to a plain HTTP reply URL.
  //
  // IIS must have Anonymous authentication ON and Windows Authentication OFF. With
  // Windows Authentication on, IIS challenges the browser before the request reaches the
  // OpenID Connect handler and sign-in never happens. install-iis.ps1 sets it correctly.
}
